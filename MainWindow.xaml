                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12"
                                            Background="#20246FF2"
                                            BorderBrush="#55246FF2"
                                            BorderThickness="1"
                                            Margin="0,0,12,0">
                                        <Path Data="M5,16 C8,6 22,6 25,16 C22,26 8,26 5,16 Z M11,16 A5,5 0 1 0 21,16 A5,5 0 1 0 11,16"
                                              Fill="#8FC7FF"
                                              Width="24" Height="24"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Lian Li Theme Editor" FontSize="21" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutVersionText" Text="Version"
                                                   Foreground="{DynamicResource BrTextTertiary}" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Padding="18"
                                            Background="{DynamicResource BrSurface2}"
                                            BorderBrush="{DynamicResource BrBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock x:Name="AboutIntroText" Text="This editor is built for people who like to make tiny screens feel personal."
                                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="AboutDescText" Text="It tries to keep the technical parts quiet: load a theme, see what is there, change it, and send it back to L-Connect without turning the whole thing into a puzzle."
                                                       Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrTextSecondary}"/>
                                            <Border Margin="0,14,0,0"
                                                    Padding="12"
                                                    Background="#16F59E0B"
                                                    BorderBrush="#55F59E0B"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <TextBlock x:Name="AboutWarningText" Text="It is an unofficial community tool, so please keep backups of themes you care about. Careful work still deserves a safety net."
                                                           TextWrapping="Wrap" Foreground="#FDE68A"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Padding="16"
                                            Background="{DynamicResource BrSurface2}"
                                            BorderBrush="{DynamicResource BrBorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Check the latest release without leaving the editor."
                                                       Grid.Row="1"
                                                       Margin="0,5,0,12"
                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <Button x:Name="CheckUpdatesButton"
                                                        Content="Check for Updates"
                                                        Tag="M17,7 A7,7 0 1 0 17,15 M17,7 L17,2 M17,7 L12,7"
                                                        Style="{DynamicResource ToolbarIconButton}"
                                                        Background="#FF2478F3"
                                                        BorderThickness="0"
                                                        Foreground="White"
                                                        Padding="16,8"
                                                        Margin="0,0,10,0"
                                                        Click="CheckUpdatesButton_Click"/>
                                                <Button x:Name="OpenGitHubButton" Content="Open GitHub"
                                                        Style="{DynamicResource ToolbarIconButton}"
                                                        Tag="M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 M10,4 V16 M5,10 H15"
                                                        Padding="14,8"
                                                        Click="OpenGitHubButton_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="UpdateStatusText"
                                                       Grid.Row="2"
                                                       Margin="0,44,0,0"
                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Padding="16"
                                            Background="{DynamicResource BrSurface2}"
                                            BorderBrush="{DynamicResource BrBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="Support" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Report bugs or suggest the next improvement."
                                                       Margin="0,5,0,12"
                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                       TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <Button x:Name="BugReportButton" Content="Bug Report"
                                                        Tag="M10,3 L18,17 H2 Z M10,7 V11 M10,14 V14.5"
                                                        Margin="0,0,8,8" Style="{DynamicResource ToolbarIconButton}" Padding="14,8" Click="OpenGitHubIssuesButton_Click"/>
                                                <Button x:Name="FeatureRequestButton" Content="Feature Request"
                                                        Tag="M10,2 A6,6 0 0 1 14,12 C13,13 12,14 12,16 H8 C8,14 7,13 6,12 A6,6 0 0 1 10,2 M8,18 H12"
                                                        Margin="0,0,8,8" Style="{DynamicResource ToolbarIconButton}" Padding="14,8" Click="FeatureRequestButton_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Padding="16"
                                            Background="{DynamicResource BrSurface2}"
                                            BorderBrush="{DynamicResource BrBorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="Diagnostics" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Collect version, device and log details for troubleshooting."
                                                       Margin="0,5,0,12"
                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                       TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <Button x:Name="CopyDiagnosticInfoButton" Content="Copy Diagnostic Info"
                                                        Tag="M6,4 H16 V16 H6 Z M4,7 H6 M4,7 V19 H13 V16"
                                                        Margin="0,0,8,8" Style="{DynamicResource ToolbarIconButton}" Padding="14,8" Click="CopyDiagnosticsButton_Click"/>
                                                <Button x:Name="AboutCreateDiagnosticPackageButton" Content="Create Diagnostic Package"
                                                        Tag="M3,5 H8 L10,7 H18 V18 H3 Z M6,11 H15 M6,14 H13"
                                                        Margin="0,0,8,8" Style="{DynamicResource ToolbarIconButton}" Padding="14,8" Click="CreateDiagnosticPackageButton_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="RecoveryAboutCard"
                                            Grid.Row="4"
                                            Padding="16"
                                            Background="#1620BFA8"
                                            BorderBrush="#5520BFA8"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Unsaved Recovery" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="RecoveryAboutText"
                                                       Text="An unsaved edit is available."
                                                       Margin="0,5,0,12"
                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                       TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <Button x:Name="RestoreRecoveryButton"
                                                        Content="Restore"
                                                        Tag="M10,3 A7,7 0 1 1 5,15 M10,3 V8 H15"
                                                        Margin="0,0,8,8"
                                                        Style="{DynamicResource ToolbarIconButton}"
                                                        Padding="14,8"
                                                        Click="RestoreRecoveryButton_Click"/>
                                                <Button x:Name="DismissRecoveryButton"
                                                        Content="Discard"
                                                        Tag="M4,4 L16,16 M16,4 L4,16"
                                                        Margin="0,0,8,8"
                                                        Style="{DynamicResource ToolbarIconButton}"
                                                        Padding="14,8"
                                                        Click="DismissRecoveryButton_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>


        <Border x:Name="FooterBorder" Grid.Row="6" Panel.ZIndex="10"
                Background="#14060E1C" BorderBrush="{DynamicResource GlassShimmerBrush}"
                BorderThickness="0,1,0,0" Padding="18,0" Margin="0" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Sol: durum noktası (status text kaldırıldı, sadece gösterge) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Orta: telif hakkı -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Dil etiketi -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <!-- Dil combo -->
                    <ColumnDefinition Width="118"/>
                    <!-- Ayırıcı -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Tema toggle -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: yalnızca durum göstergesi (bileşenler hidden, kod uyumluluğu için) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource BrAccent}" Margin="2,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource BrTextTertiary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TemplateTitleText" Text="" Visibility="Collapsed"/>
                    <TextBlock x:Name="TemplatePathText" Text="" Visibility="Collapsed"/>
                    <TextBlock x:Name="BackgroundText" Text="" Visibility="Collapsed"/>
                    <ProgressBar x:Name="ApplyProgressBar"
                                 Width="180" Height="7" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"
                                 Margin="14,0,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Orta: telif hakkı -->
                <TextBlock Grid.Column="1"
                           Text="&#214;zg&#252;r Yal&#231;&#305;n | 2026"
                           Foreground="{DynamicResource BrTextTertiary}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <!-- Dil etiketi -->
                <TextBlock x:Name="LanguageLabel" Grid.Column="3" Text="Language"
                           Foreground="{DynamicResource BrTextTertiary}" VerticalAlignment="Center"/>
                <!-- Dil seçimi -->
                <ComboBox x:Name="LanguageCombo" Grid.Column="5" Height="28" VerticalAlignment="Center"
                          SelectedValuePath="Tag" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="" Tag="en"/>
                    <ComboBoxItem Content="" Tag="tr"/>
                    <ComboBoxItem Content="" Tag="ru"/>
                    <ComboBoxItem Content="" Tag="zh"/>
                </ComboBox>

                <!-- Ayırıcı çizgi (Language ile ThemeToggle arasında) -->
                <Rectangle Grid.Column="7" Width="1" Fill="#30496E9F" VerticalAlignment="Stretch" Margin="0,6"/>

                <!-- Gizli tema combo (eski, kod uyumluluğu için) -->
                <TextBlock x:Name="ThemeLabel" Text="Theme" Visibility="Collapsed"/>
                <ComboBox x:Name="UiThemeCombo" Height="28" Visibility="Collapsed"
                          SelectedValuePath="Tag" SelectionChanged="UiThemeCombo_SelectionChanged">
                    <ComboBoxItem x:Name="DarkThemeItem" Content="Dark" Tag="dark"/>
                    <ComboBoxItem x:Name="LightThemeItem" Content="Light" Tag="light"/>
                </ComboBox>

                <!-- Karanlık / Aydınlık tema toggle -->
                <ToggleButton x:Name="ThemeToggleButton" Grid.Column="9"
                              Width="30" Height="30"
                              VerticalAlignment="Center"
                              Background="#FF102241"
                              BorderBrush="#8045A0FF"
                              BorderThickness="1"
                              Cursor="Hand" ToolTip="Switch to light theme"
                              Checked="ThemeToggleButton_Changed"
                              Unchecked="ThemeToggleButton_Changed">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <Path x:Name="MoonIcon" Data="M14,3 C8,4 5,9 7,14 C9,19 15,20 19,16 C12,17 8,10 14,3 Z"
                                          Fill="#F3F8FF" Width="15" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Grid x:Name="SunIcon" Visibility="Collapsed" Width="17" Height="17"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#C26A00"/>
                                        <Path Data="M10,0 L10,4 M10,16 L10,20 M0,10 L4,10 M16,10 L20,10 M3,3 L6,6 M14,14 L17,17 M17,3 L14,6 M6,14 L3,17"
                                              Stroke="#C26A00" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Root" Property="Background" Value="#FF102241"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#8045A0FF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="MoonIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SunIcon" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Root" Property="Background" Value="#FFFFF2CF"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#CCB66D00"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Root" Property="Background" Value="#FF17345F"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#CC5CB0FF"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Root" Property="Background" Value="#FFFFE4A3"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#E08A5200"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>

























