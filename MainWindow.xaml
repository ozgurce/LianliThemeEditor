<Window x:Class="ThemeEditorCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lian Li LCD Template Editor V 1.0 Beta"
        Width="1400"
        Height="900"
        MinWidth="1250"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="editor.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BrBg}"
        Foreground="{DynamicResource BrTextPrimary}"
        FontFamily="Segoe UI Variable Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="ColBg">#07152F</Color>
        <!-- Glass surface: very low alpha so background bleeds through -->
        <Color x:Key="ColSurface">#1A10264A</Color>
        <Color x:Key="ColSurface2">#22172E59</Color>
        <Color x:Key="ColField">#30091626</Color>
        <Color x:Key="ColBorder">#45294A7A</Color>
        <Color x:Key="ColBorderSoft">#604977B7</Color>
        <Color x:Key="ColAccent">#2478F3</Color>
        <Color x:Key="ColAccentHover">#45A0FF</Color>
        <Color x:Key="ColDanger">#963434</Color>
        <Color x:Key="ColPurple">#493B83</Color>
        <Color x:Key="ColTextPrimary">#F5F7FA</Color>
        <Color x:Key="ColTextSecondary">#C9D1D9</Color>
        <Color x:Key="ColTextTertiary">#8F9AA8</Color>
        <Color x:Key="ColHover">#30234A82</Color>

        <SolidColorBrush x:Key="BrBg" Color="#07152F"/>
        <SolidColorBrush x:Key="BrSurface" Color="{StaticResource ColSurface}"/>
        <SolidColorBrush x:Key="BrSurface2" Color="{StaticResource ColSurface2}"/>
        <SolidColorBrush x:Key="BrField" Color="{StaticResource ColField}"/>
        <SolidColorBrush x:Key="BrBorder" Color="{StaticResource ColBorder}"/>
        <SolidColorBrush x:Key="BrBorderSoft" Color="{StaticResource ColBorderSoft}"/>
        <SolidColorBrush x:Key="BrAccent" Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentHover" Color="{StaticResource ColAccentHover}"/>
        <SolidColorBrush x:Key="BrDanger" Color="{StaticResource ColDanger}"/>
        <SolidColorBrush x:Key="BrPurple" Color="{StaticResource ColPurple}"/>
        <SolidColorBrush x:Key="BrTextPrimary" Color="{StaticResource ColTextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource ColTextSecondary}"/>
        <SolidColorBrush x:Key="BrTextTertiary" Color="{StaticResource ColTextTertiary}"/>
        <SolidColorBrush x:Key="BrHover" Color="{StaticResource ColHover}"/>
        <SolidColorBrush x:Key="BrSelectedLayer" Color="#70246FF2"/>
        <SolidColorBrush x:Key="BrGridHeader" Color="#202630"/>
        <SolidColorBrush x:Key="BrGridRow" Color="#151A22"/>
        <SolidColorBrush x:Key="BrGridAltRow" Color="#181D26"/>
        <SolidColorBrush x:Key="BrGridCellBorder" Color="#252B35"/>
        <SolidColorBrush x:Key="BrDecor1" Color="#253E91FF"/>
        <SolidColorBrush x:Key="BrDecor2" Color="#214A53D8"/>
        <SolidColorBrush x:Key="BrDecor3" Color="#1826C6A5"/>
        <SolidColorBrush x:Key="BrDecorStroke" Color="#1E68A8FF"/>
        <!-- TRUE glassmorphism panel: slightly more opaque so panels are visible but still translucent -->
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#550D2040" Offset="0"/>
            <GradientStop Color="#420A1A35" Offset="0.52"/>
            <GradientStop Color="#580D2040" Offset="1"/>
        </LinearGradientBrush>
        <!-- Bright top-edge shimmer line for glass cards -->
        <LinearGradientBrush x:Key="GlassShimmerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#005080B0" Offset="0"/>
            <GradientStop Color="#505080B0" Offset="0.3"/>
            <GradientStop Color="#705488C8" Offset="0.5"/>
            <GradientStop Color="#505080B0" Offset="0.7"/>
            <GradientStop Color="#005080B0" Offset="1"/>
        </LinearGradientBrush>
        <!-- Title bar: deep, semi-transparent glass -->
        <LinearGradientBrush x:Key="GlassHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E0060E20" Offset="0"/>
            <GradientStop Color="#C0040C1A" Offset="0.5"/>
            <GradientStop Color="#E0060E20" Offset="1"/>
        </LinearGradientBrush>
        <!-- Toolbar row glass -->
        <LinearGradientBrush x:Key="GlassToolbarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D00B1F3E" Offset="0"/>
            <GradientStop Color="#B0071528" Offset="0.5"/>
            <GradientStop Color="#D00B1F3E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPopupBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0122D58" Offset="0"/>
            <GradientStop Color="#D50B2348" Offset="0.55"/>
            <GradientStop Color="#E2143563" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlassBackgroundBrush" Center="0.24,0.05" GradientOrigin="0.24,0.05" RadiusX="1.15" RadiusY="1.15">
            <GradientStop Color="#243D7B" Offset="0"/>
            <GradientStop Color="#102956" Offset="0.35"/>
            <GradientStop Color="#07162F" Offset="1"/>
        </RadialGradientBrush>
        <!-- Glassmorphism accent brushes -->
        <LinearGradientBrush x:Key="GlassAccentBorderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#401A4A8C" Offset="0"/>
            <GradientStop Color="#802478F3" Offset="0.45"/>
            <GradientStop Color="#401A4A8C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerSeparatorBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#001A4A8C" Offset="0"/>
            <GradientStop Color="#602478F3" Offset="0.35"/>
            <GradientStop Color="#802478F3" Offset="0.65"/>
            <GradientStop Color="#001A4A8C" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="ShadowCard" BlurRadius="28" ShadowDepth="2" Direction="270" Color="#000820" Opacity="0.55"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}"/>
            <!-- Glass border: top/left slightly brighter for light refraction effect -->
            <Setter Property="BorderBrush" Value="{DynamicResource GlassShimmerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="38" Height="20" Margin="0,0,7,0">
                                <Border x:Name="Track"
                                        CornerRadius="10"
                                        Background="{DynamicResource BrSurface2}"
                                        BorderBrush="{DynamicResource BrBorder}"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="Thumb"
                                         Width="14"
                                         Height="14"
                                         Fill="{DynamicResource BrTextTertiary}"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrAccent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource BrField}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrTextPrimary}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BrField}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BrField}"
                                                BorderBrush="{DynamicResource BrBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Path Fill="{DynamicResource BrTextTertiary}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectionContent"
                                              Margin="10,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBlock x:Name="EditableTextDisplay"
                                       Margin="10,0,32,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrTextPrimary}"
                                       Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="{DynamicResource BrSurface2}"
                                        BorderBrush="{DynamicResource BrBorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1">
                                        <ScrollViewer MaxHeight="260" Padding="4">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="EditableTextDisplay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass button style for Export/Restart/Apply in header toolbar -->
        <Style x:Key="GlassHeaderBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#28152D55"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#50496E9F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#48234A82"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#90496E9F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="94"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource BrAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{DynamicResource BrDanger}"/>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{DynamicResource BrSurface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BtnNudge" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="CompactNumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,1"/>
        </Style>

        <Style x:Key="NumericSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrAccent}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="6" CornerRadius="3"
                                    Background="#30FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                    Margin="5,0"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Margin="5,0,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4A26B0" Offset="0"/>
                                                            <GradientStop Color="#713BCE" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="14" Height="14" Fill="White">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4" Color="Black"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrAccent}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactStepLeft" TargetType="Button" BasedOn="{StaticResource BtnNudge}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                CornerRadius="6,0,0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactStepRight" TargetType="Button" BasedOn="{StaticResource BtnNudge}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                CornerRadius="0,6,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style x:Key="SidebarPrimaryButton" TargetType="Button" BasedOn="{StaticResource SidebarActionButton}">
            <Setter Property="Background" Value="{DynamicResource BrAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SidebarDangerButton" TargetType="Button" BasedOn="{StaticResource SidebarActionButton}">
            <Setter Property="Background" Value="{DynamicResource BrDanger}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="ColorPickerButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Content" Value="●"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource BrAccentHover}"/>
        </Style>

        <Style x:Key="ColorPickerButtonFixed" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrAccentHover}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{TemplateBinding Foreground}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="{DynamicResource BrGridRow}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrGridAltRow}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BrGridHeader}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="SeparatorBrush" Value="{DynamicResource BrBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrGridCellBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="12,0,8,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrSelectedLayer}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrSelectedLayer}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LayerGridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="LayerGridCenterText" TargetType="TextBlock" BasedOn="{StaticResource LayerGridText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LayerGridCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                CornerRadius="4"
                                Background="#0F1319"
                                BorderBrush="#596475"
                                BorderThickness="1">
                            <Path x:Name="Tick"
                                  Data="M 3 8 L 7 12 L 15 4"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#159084"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#31C7B8"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#55D6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerCardGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="84"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerTypeChoiceButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource BrSurface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
        </Style>

        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3553848F"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#58749D" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#748398"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource BrAccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource BrSurface2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource ScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="9"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="9"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassShimmerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Effect="{StaticResource ShadowCard}"
                                ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="18,14"
                                              Cursor="Hand"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Hdr" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2"
                                                               Fill="{DynamicResource BrAccent}" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <ContentPresenter Grid.Column="1"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True"/>
                                                    <Border Grid.Column="2" Width="28" Height="28" CornerRadius="14"
                                                            Background="#20152D55" VerticalAlignment="Center">
                                                        <Path x:Name="Chevron"
                                                              Data="M 7 10 L 14 17 L 21 10"
                                                              Stroke="{DynamicResource BrTextTertiary}"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hdr" Property="Background" Value="#15234A82"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Visibility="Collapsed"
                                                  Margin="18,0,18,18"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Margin="0">
        <Grid.Background>
            <ImageBrush ImageSource="Assets/glass-background.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Canvas Grid.RowSpan="7" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.7" CacheMode="BitmapCache">
            <Ellipse Width="760" Height="520" Canvas.Left="-180" Canvas.Top="-230" Fill="{DynamicResource BrDecor1}">
                <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="620" Height="620" Canvas.Right="-180" Canvas.Top="110" Fill="{DynamicResource BrDecor2}">
                <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="520" Height="360" Canvas.Left="620" Canvas.Bottom="-170" Fill="{DynamicResource BrDecor3}">
                <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
            </Ellipse>
            <Path Data="M 0,330 C 360,180 700,470 1080,260 C 1380,95 1640,180 1920,40"
                  Stroke="{DynamicResource BrDecorStroke}" StrokeThickness="70" Opacity="0.28">
                <Path.Effect><BlurEffect Radius="75"/></Path.Effect>
            </Path>
        </Canvas>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TITLE BAR  – glassmorphism frosted banner                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource GlassHeaderBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- LEFT: Logo + title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Lian Li logo badge -->
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                            BorderThickness="1" BorderBrush="#50246FF2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF1A5BC4" Offset="0"/>
                                <GradientStop Color="#FF0A3488" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="L" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Lian Li LCD Template Editor"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource BrTextPrimary}"
                               Margin="0,0,8,0"/>
                    <!-- version pill -->
                    <Border CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                            Background="#30246FF2" BorderBrush="#40246FF2" BorderThickness="1">
                        <TextBlock Text="V 1.0 Beta" FontSize="10" Foreground="{DynamicResource BrTextTertiary}"/>
                    </Border>
                </StackPanel>

                <!-- RIGHT: Window controls (hit-test visible) -->
                <Border HorizontalAlignment="Right" Padding="0,0,4,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize -->
                        <Button Click="MinimizeButton_Click" Width="40" Height="28"
                                MinWidth="40" Margin="0,0,2,0" Cursor="Hand"
                                ToolTip="Minimize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Maximize -->
                        <Button Click="MaximizeButton_Click" Width="40" Height="28"
                                MinWidth="40" Margin="0,0,2,0" Cursor="Hand"
                                ToolTip="Maximize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Close -->
                        <Button Click="CloseButton_Click" Width="40" Height="28"
                                MinWidth="40" Cursor="Hand" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#C0C42B2B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#90C42B2B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Thin glowing separator line between title bar and toolbar -->
        <Rectangle Grid.Row="1" Fill="{StaticResource BannerSeparatorBrush}" Height="1" VerticalAlignment="Stretch"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TOOLBAR / HEADER ROW  – glassmorphism card                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource GlassToolbarBrush}"
                BorderBrush="{StaticResource GlassAccentBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,0" Margin="0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Device selector -->
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Template selector -->
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Load / Save / Undo / Redo -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <!-- Export / Restart / Apply -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DEVICE glass chip -->
                <Border Grid.Column="0" Background="#40152D55" BorderBrush="#60496E9F"
                        BorderThickness="1" CornerRadius="8" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7"
                                BorderThickness="1" BorderBrush="#40246FF2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF1048A0" Offset="0"/>
                                    <GradientStop Color="#FF082060" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="D" FontWeight="Bold" FontSize="12" Foreground="#80B8FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="DeviceLabel" Text="DEVICE" FontSize="8.5"
                                       FontWeight="SemiBold"
                                       Foreground="#607090A8" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <ComboBox x:Name="DeviceCombo" Margin="0,14,0,0" Height="26"
                                      SelectedValuePath="Tag" SelectionChanged="DeviceCombo_SelectionChanged">
                                <ComboBoxItem Content="Hydroshift II LCD-S" Tag="hydroshift-ii-lcd-s"/>
                                <ComboBoxItem Content="Hydroshift II LCD-C" Tag="hydroshift-ii-lcd-c"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TEMPLATE glass chip -->
                <Border Grid.Column="2" Background="#40152D55" BorderBrush="#60496E9F"
                        BorderThickness="1" CornerRadius="8" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7"
                                BorderThickness="1" BorderBrush="#40228040">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF104830" Offset="0"/>
                                    <GradientStop Color="#FF082818" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="T" FontWeight="Bold" FontSize="12" Foreground="#60D48A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Grid Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="TemplateLabel" Text="TEMPLATE" FontSize="8.5"
                                       FontWeight="SemiBold"
                                       Foreground="#607090A8" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <ComboBox x:Name="TemplateCombo" Margin="0,14,0,0" Height="26"
                                      SelectionChanged="TemplateCombo_SelectionChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Vertical divider 1 -->
                <Rectangle Grid.Column="4" Width="1" Height="32"
                            Fill="#40496E9F" VerticalAlignment="Center"/>

                <!-- Load / Save / Undo / Redo icon buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LoadButton" Content="Load"
                            Tag="M2,5 L7,5 L9,7 L18,7 L18,17 L2,17 Z M2,5 L2,3 L8,3 L10,5"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="LoadButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save"
                            Tag="M3,2 L16,2 L19,5 L19,18 L3,18 Z M6,2 L6,8 L15,8 L15,2 M7,18 L7,12 L15,12 L15,18"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="ApplyAllButton_Click"/>
                    <Button x:Name="UndoButton" Content="Undo"
                            Tag="M7,6 L3,10 L7,14 M4,10 L12,10 C16,10 18,13 18,17"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="UndoButton_Click" ToolTip="Revert last template change (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Content="Redo"
                            Tag="M13,6 L17,10 L13,14 M16,10 L8,10 C4,10 2,13 2,17"
                            Style="{DynamicResource ToolbarIconButton}"
                            Click="RedoButton_Click" ToolTip="Restore template change (Ctrl+Y)"/>
                    <ToggleButton x:Name="ThemeToggleButton" Width="38" Height="38" Margin="6,0,0,0"
                                  Cursor="Hand" ToolTip="Switch to light theme"
                                  Checked="ThemeToggleButton_Changed"
                                  Unchecked="ThemeToggleButton_Changed">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Path x:Name="MoonIcon" Data="M14,3 C8,4 5,9 7,14 C9,19 15,20 19,16 C12,17 8,10 14,3 Z"
                                              Fill="#444444" Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Grid x:Name="SunIcon" Visibility="Collapsed" Width="20" Height="20"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="#FFB72E"/>
                                            <Path Data="M10,0 L10,4 M10,16 L10,20 M0,10 L4,10 M16,10 L20,10 M3,3 L6,6 M14,14 L17,17 M17,3 L14,6 M6,14 L3,17"
                                                  Stroke="#FFB72E" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="MoonIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="SunIcon" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Root" Property="Background" Value="#30FFB72E"/>
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#80FFB72E"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <!-- Vertical divider 2 -->
                <Rectangle Grid.Column="8" Width="1" Height="32"
                            Fill="#40496E9F" VerticalAlignment="Center"/>

                <!-- Hidden template ID box -->
                <TextBox x:Name="TemplateIdBox" ToolTip="Template ID" Visibility="Collapsed"
                         Grid.Column="10"/>
                <CheckBox x:Name="UseActiveCheck" Grid.Column="10" Content="Active theme"
                          IsChecked="True" Checked="UseActiveCheck_Changed"
                          Visibility="Collapsed"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- RIGHT ACTION BUTTONS -->
                <StackPanel Grid.Column="11" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Theme – teal accent -->
                    <Button x:Name="ExportLConnectButton"
                            Tag="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,19 L17,19 L17,16"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0" Background="#2020BFA8"
                            BorderBrush="#6620BFA8" BorderThickness="1" Foreground="#009E8F"
                            Click="ExportLConnectButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#001225"/>
                        </Button.Effect>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExportLConnectButtonText" Text="Export Theme" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- Restart L-Connect – red/pink accent -->
                    <Button x:Name="RestartButton"
                            Tag="M17,7 A7,7 0 1 0 17,15 M17,7 L17,2 M17,7 L12,7"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0" Background="#20D55263"
                            BorderBrush="#66D55263" BorderThickness="1" Foreground="#D43F53"
                            Click="RestartButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#001225"/>
                        </Button.Effect>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RestartButtonText" Text="Restart L-Connect" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- Apply All – solid blue accent (highlight button) -->
                    <Button x:Name="ApplyAllButton"
                            Tag="M3,10 L8,15 L18,4"
                            Style="{DynamicResource ToolbarIconButton}"
                            BorderThickness="0"
                            Click="ApplyAllButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF1A6CD8" Offset="0"/>
                                <GradientStop Color="#FF246FF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M3,10 L8,15 L18,4"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                </Viewbox>
                                <TextBlock Text="Apply All" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <TextBlock x:Name="SupporterPathText" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="16,0">
            <Grid Grid.Column="0" Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="270"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="470" MinWidth="420"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource GlassToolbarBrush}" BorderBrush="{DynamicResource GlassShimmerBrush}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Width="4" Height="18" Fill="{DynamicResource BrAccent}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="LayersHeaderText" Text="Layers" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorder}"
                                            BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="LayerCountText" Text="0 layers"
                                                   Foreground="{DynamicResource BrTextTertiary}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="AddLayerMenuButton" Style="{DynamicResource BtnPrimary}"
                                            Width="112" MinWidth="112" Height="34" Padding="12,0"
                                            Click="AddLayerMenuButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="+" FontSize="19" FontWeight="Normal"
                                                       VerticalAlignment="Center" Margin="0,-2,7,0"/>
                                            <TextBlock Text="Add Layer" FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Popup x:Name="AddLayerMenuPopup" PlacementTarget="{Binding ElementName=AddLayerMenuButton}"
                                           Placement="Bottom" HorizontalOffset="-222"
                                           StaysOpen="False" AllowsTransparency="True">
                                        <Border Width="390" Background="{DynamicResource GlassPopupBrush}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1"
                                                CornerRadius="14" Padding="16" Margin="0,10,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270"
                                                                  Color="#000000" Opacity="0.45"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid Margin="6,2,6,12">
                                                    <StackPanel>
                                                        <TextBlock Text="Add Layer" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Choose content for the canvas." Margin="0,4,0,0"
                                                                   FontSize="10.5" Foreground="{DynamicResource BrTextTertiary}"/>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Width="28" Height="28" CornerRadius="8" Background="{DynamicResource BrSurface2}">
                                                        <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource BrAccentHover}"/>
                                                    </Border>
                                                </Grid>
                                                <UniformGrid Columns="2">
                                                    <Button Tag="Text" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="8" Background="#246FF2"><TextBlock Text="T" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Text" FontWeight="SemiBold"/><TextBlock Text="Static content" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Data" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="8" Background="#159CBA"><TextBlock Text="01" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Data" FontWeight="SemiBold"/><TextBlock Text="Live sensor value" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Image" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="8" Background="#35A84B"><TextBlock Text="IMG" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Image" FontWeight="SemiBold"/><TextBlock Text="PNG or JPG" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Graph" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="8" Background="#713BCE"><TextBlock Text="G" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Graph" FontWeight="SemiBold"/><TextBlock Text="Bar or gauge" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="LayerGrid" Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding Layers}" SelectionChanged="LayerGrid_SelectionChanged" SelectionMode="Single" IsReadOnly="False" CellEditEnding="LayerGrid_CellEditEnding"
                                  AllowDrop="True" DragOver="LayerGrid_DragOver" Drop="LayerGrid_Drop"
                                  Style="{DynamicResource LayerCardGrid}" VerticalContentAlignment="Center">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="LayerCard"
                                                    Margin="8,3"
                                                    Padding="8,7"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource BrSurface2}"
                                                    BorderBrush="{DynamicResource BrBorderSoft}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                                      Color="#000820" Opacity="0.40"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                        <Grid x:Name="LayerDragHandle" Grid.Column="0" Width="18" Height="28"
                                                              VerticalAlignment="Center" Opacity="0.9" Cursor="SizeNS"
                                                              Background="Transparent"
                                                              ToolTip="Drag to reorder"
                                                              PreviewMouseLeftButtonDown="LayerDragHandle_MouseLeftButtonDown"
                                                              PreviewMouseMove="LayerDragHandle_MouseMove"
                                                              PreviewMouseLeftButtonUp="LayerDragHandle_MouseLeftButtonUp">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border Width="13" Height="2" CornerRadius="1" Background="{DynamicResource BrTextTertiary}" Margin="0,2"/>
                                                                <Border Width="13" Height="2" CornerRadius="1" Background="{DynamicResource BrTextTertiary}" Margin="0,2"/>
                                                                <Border Width="13" Height="2" CornerRadius="1" Background="{DynamicResource BrTextTertiary}" Margin="0,2"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border x:Name="LayerTypeIcon" Grid.Column="1" Width="32" Height="32"
                                                                CornerRadius="8" Background="#246FF2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock x:Name="LayerTypeIconText" Text="G"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="8,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource BrTextPrimary}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DataSource}" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource BrTextSecondary}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Media}" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="3" Width="28" Height="24" CornerRadius="7"
                                                                Background="{DynamicResource BrField}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Index, StringFormat=\#{0}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource BrTextTertiary}" FontSize="10"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="GraphAnimation">
                                                        <Setter TargetName="LayerTypeIcon" Property="Background" Value="#713BCE"/>
                                                        <Setter TargetName="LayerTypeIconText" Property="Text" Value="▶"/>
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="GraphItem">
                                                    <Setter TargetName="LayerTypeIcon" Property="Background" Value="#246FF2"/>
                                                    <Setter TargetName="LayerTypeIconText" Property="Text" Value="T"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="GraphImage">
                                                    <Setter TargetName="LayerTypeIcon" Property="Background" Value="#35A84B"/>
                                                    <Setter TargetName="LayerTypeIconText" Property="Text" Value="IMG"/>
                                                    <Setter TargetName="LayerTypeIconText" Property="FontSize" Value="9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Background" Value="{DynamicResource BrHover}"/>
                                                    <Setter TargetName="LayerCard" Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Background" Value="{DynamicResource BrSelectedLayer}"/>
                                                    <Setter TargetName="LayerCard" Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                                                    <Setter TargetName="LayerCard" Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

                <Border Grid.Row="0" Grid.Column="4" Style="{DynamicResource Card}" Padding="18" BorderThickness="1.5,1.5,0,0" BorderBrush="{DynamicResource BrBorderSoft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Expander Grid.Row="0" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock x:Name="EditLayerHeaderText" Text="Properties" FontSize="15" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                        <StackPanel x:Name="PropertyEditorContent" Visibility="Collapsed">
                            <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1"
                                    CornerRadius="9" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#246FF2">
                                        <TextBlock x:Name="SelectedLayerIconText" Text="T" FontWeight="Bold"
                                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="SelectedLayerTypeText" Text="" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SelectedLayerDetailText" Text="" Foreground="{DynamicResource BrTextTertiary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="GeneralPropertiesCard" Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="POSITION &amp; SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrTextSecondary}" Margin="0,0,0,14"/>
                                    <Grid x:Name="GeneralPropertiesGrid">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Columns="4" Margin="0,0,0,16">
                                            <Button x:Name="MoveUpButton" Content="Move Up" Style="{DynamicResource SidebarActionButton}" Click="MoveUpButton_Click"/>
                                            <Button x:Name="MoveDownButton" Content="Move Down" Style="{DynamicResource SidebarActionButton}" Click="MoveDownButton_Click"/>
                                            <Button x:Name="ApplyButton" Content="Apply" Style="{DynamicResource SidebarPrimaryButton}" Click="ApplyButton_Click"/>
                                            <Button x:Name="RemoveButton" Content="Remove" Style="{DynamicResource SidebarDangerButton}" Click="RemoveButton_Click"/>
                                        </UniformGrid>

                                        <Label x:Name="IndexLabel" Grid.Row="1" Grid.Column="0" Content="INDEX" Visibility="Collapsed" Margin="0,0,0,8"/>
                                        <TextBox x:Name="IndexBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Visibility="Collapsed" Margin="0,0,0,8"/>

                                        <Label Grid.Row="2" Grid.Column="0" Content="X" Margin="0,0,0,8"/>
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                            <Button Content="-" Style="{DynamicResource CompactStepLeft}" Click="XMinus_Click"/>
                                            <TextBox x:Name="XBox" Grid.Column="1" Style="{DynamicResource CompactNumberBox}"/>
                                            <Button Grid.Column="2" Content="+" Style="{DynamicResource CompactStepRight}" Click="XPlus_Click"/>
                                        </Grid>

                                        <Label Grid.Row="3" Grid.Column="0" Content="Y" Margin="0,0,0,8"/>
                                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                            <Button Content="-" Style="{DynamicResource CompactStepLeft}" Click="YMinus_Click"/>
                                            <TextBox x:Name="YBox" Grid.Column="1" Style="{DynamicResource CompactNumberBox}"/>
                                            <Button Grid.Column="2" Content="+" Style="{DynamicResource CompactStepRight}" Click="YPlus_Click"/>
                                        </Grid>

                                        <Label x:Name="SizeLabel" Grid.Row="4" Grid.Column="0" Content="W" Margin="0,0,0,8"/>
                                        <Grid x:Name="SizePanel" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
