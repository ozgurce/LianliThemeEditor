                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TemplateHeader" Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TemplateHeader" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
