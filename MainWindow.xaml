                                MinWidth="40" Margin="0,0,2,0" Cursor="Hand"
                                ToolTip="Maximize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Close -->
                        <Button x:Name="CloseWindowButton" Click="CloseButton_Click" Width="40" Height="28"
                                MinWidth="40" Cursor="Hand" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#C0C42B2B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#90C42B2B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Thin glowing separator line between title bar and toolbar -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BannerSeparatorBrush}" Height="1" VerticalAlignment="Stretch"/>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- TOOLBAR / HEADER ROW  â€“ glassmorphism card                     -->
        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <!-- â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  -->
        <!-- TOOLBAR / HEADER ROW  â€“ glassmorphism card                     -->
        <!-- â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  -->
        <Border x:Name="EditorToolbar" Grid.Row="3" Panel.ZIndex="5"
                Height="52" VerticalAlignment="Center"
                Background="{DynamicResource GlassToolbarBrush}"
                BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,0" Margin="16,5,16,5" CornerRadius="12">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Device selector -->
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Template selector -->
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Load / Save / Undo / Redo -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <!-- Export / Restart / Apply -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DEVICE glass chip -->
                <Border Grid.Column="0" Height="38" Background="#40152D55" BorderBrush="#60496E9F"
                        BorderThickness="1" CornerRadius="8" Padding="6,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Sol etiket: dikey yazı -->
                        <Border Grid.Column="0" Background="#18496E9F" CornerRadius="5" Padding="5,4" Margin="0,0,6,0">
                            <TextBlock x:Name="DeviceLabel" Text="DEVICE" FontSize="7.5"
                                       FontWeight="Bold"
                                       Foreground="#80A0B8D0" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <!-- Cihaz ikonu -->
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="6"
                                BorderThickness="1" BorderBrush="#40246FF2" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF1048A0" Offset="0"/>
                                    <GradientStop Color="#FF082060" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image x:Name="SelectedDeviceImage" Source="Assets/Devices/hydroshift-ii-lcd-s.png"
                                   Stretch="UniformToFill"/>
                        </Border>
                        <!-- Seçim alanı (Combo üstunde görünen custom UI) -->
                        <Grid Grid.Column="2">
                            <ComboBox x:Name="DeviceCombo" Height="26"
                                      SelectedValuePath="Tag" SelectionChanged="DeviceCombo_SelectionChanged"
                                      IsTextSearchEnabled="False" Opacity="0">
                                <ComboBoxItem Tag="hydroshift-ii-lcd-s" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/hydroshift-ii-lcd-s.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="Hydroshift II LCD-S" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="hydroshift-ii-lcd-c" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/hydroshift-ii-lcd-c.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="Hydroshift II LCD-C" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="universal-screen-8.8-inch" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/universal-screen-8.8.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="8.8&quot; Universal Screen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="vm-9.2-inch" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/vm-9.2.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="VM 9.2 LCD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            <Border Height="26" Background="{DynamicResource BrSelectionField}"
                                    BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                    CornerRadius="7" IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock x:Name="DeviceSelectionText" Margin="9,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Path Fill="{DynamicResource BrTextTertiary}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TEMPLATE glass chip -->
                <Border Grid.Column="2" Height="38" Background="#40152D55" BorderBrush="#60496E9F"
                        BorderThickness="1" CornerRadius="8" Padding="6,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Sol etiket: dikey yazı -->
                        <Border Grid.Column="0" Background="#18228040" CornerRadius="5" Padding="5,4" Margin="0,0,6,0">
                            <TextBlock x:Name="TemplateLabel" Text="TEMPLATE" FontSize="7.5"
                                       FontWeight="Bold"
                                       Foreground="#8070A890" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <!-- Template ikonu -->
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="6"
                                BorderThickness="1" BorderBrush="#40228040" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF104830" Offset="0"/>
                                    <GradientStop Color="#FF082818" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image x:Name="SelectedTemplateImage" Stretch="UniformToFill"/>
                        </Border>
                        <!-- Seçim alanı -->
                        <Grid Grid.Column="2">
                            <ComboBox x:Name="TemplateCombo" Height="26"
                                      SelectionChanged="TemplateCombo_SelectionChanged"
                                      IsTextSearchEnabled="False" Opacity="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" MinHeight="62">
                                            <Border Width="104" Height="54" CornerRadius="5" ClipToBounds="True"
                                                    Background="{DynamicResource BrSurface2}" Margin="0,4,11,4">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Id}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Height="26" Background="{DynamicResource BrSelectionField}"
                                    BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                    CornerRadius="7" IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock x:Name="TemplateSelectionText" Margin="9,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Path Fill="{DynamicResource BrTextTertiary}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Vertical divider 1 -->
                <Rectangle Grid.Column="4" Width="1" Height="32"
                            Fill="#40496E9F" VerticalAlignment="Center"/>

                <!-- Load / Save / Undo / Redo icon buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ActiveThemeButton" Content="Active Theme"
                            Tag="M3,4 L17,4 L17,16 L3,16 Z M6,8 L10,12 L15,7"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="ActiveThemeButton_Click"/>
                    <Button x:Name="LoadButton" Content="Load"
                            Tag="M2,5 L7,5 L9,7 L18,7 L18,17 L2,17 Z M2,5 L2,3 L8,3 L10,5"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="LoadButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save"
                            Tag="M3,2 L16,2 L19,5 L19,18 L3,18 Z M6,2 L6,8 L15,8 L15,2 M7,18 L7,12 L15,12 L15,18"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="ApplyAllButton_Click"/>
                    <Button x:Name="UndoButton" Content="" Width="38"
                            Tag="M7,6 L3,10 L7,14 M4,10 L12,10 C16,10 18,13 18,17"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="UndoButton_Click" ToolTip="Revert last template change (Ctrl+Z)"/>
                    <Button x:Name="UndoHistoryButton" Content="" Width="38"
                            Tag="M4,5 H16 M4,10 H16 M4,15 H12"
                            Style="{DynamicResource ToolbarIconButton}" Margin="-4,0,6,0"
                            Click="UndoHistoryButton_Click" ToolTip="Edit history"/>
                    <Button x:Name="RedoButton" Content="" Width="38"
                            Tag="M13,6 L17,10 L13,14 M16,10 L8,10 C4,10 2,13 2,17"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="RedoButton_Click" ToolTip="Restore template change (Ctrl+Y)"/>
                </StackPanel>

                <!-- Vertical divider 2 -->
                <Rectangle Grid.Column="8" Width="1" Height="32"
                            Fill="#40496E9F" VerticalAlignment="Center"/>

                <!-- Hidden template ID box -->
                <TextBox x:Name="TemplateIdBox" ToolTip="Template ID" Visibility="Collapsed"
                         Grid.Column="10"/>
                <CheckBox x:Name="UseActiveCheck" Grid.Column="10" Content="Active theme"
                          IsChecked="True" Checked="UseActiveCheck_Changed"
                          Visibility="Collapsed"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <CheckBox x:Name="OfflineModeCheck" Grid.Column="10" Content="Offline"
                          ToolTip="Work on a local copy without sending changes to L-Connect"
                          Checked="OfflineModeCheck_Changed" Unchecked="OfflineModeCheck_Changed"
                          VerticalAlignment="Center" HorizontalAlignment="Right"
                          Margin="0,0,10,0"/>

                <!-- RIGHT ACTION BUTTONS -->
                <StackPanel Grid.Column="11" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Theme â€“ teal accent -->
                    <Button x:Name="BackupButton" Content="" Width="38" ToolTip="Create backup"
                            Tag="M3,7 H17 V18 H3 Z M2,4 H18 V8 H2 Z M7,11 H13 M10,10 V15 M7,12 L10,15 L13,12"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="BackupButton_Click"/>
                    <Button x:Name="RestoreBackupButton" Content="" Width="38" ToolTip="Restore backup"
                            Tag="M17,10 A7,7 0 1 1 15,5 M15,2 V6 H11"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,8,0"
                            Click="RestoreBackupButton_Click"/>
                    <Button x:Name="ExportLConnectButton"
                            Tag="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,19 L17,19 L17,16"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0" Background="#2020BFA8"
                            BorderBrush="#6620BFA8" BorderThickness="1" Foreground="#009E8F"
                            Click="ExportLConnectButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#001225"/>
                        </Button.Effect>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExportLConnectButtonText" Text="Export Theme" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- Restart L-Connect â€“ red/pink accent -->
                    <Button x:Name="EditorSendThemeButton"
                            Content="Send Theme"
                            Tag="M10,3 V14 M6,7 L10,3 L14,7 M4,17 H16"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0"
                            Click="SendCurrentThemeButton_Click"/>

                    <Button x:Name="EditorImportThemeButton"
                            Content="Import Theme"
                            Tag="M4,18 L4,15 C4,13 6,12 8,12 H12 C14,12 16,13 16,15 V18 M10,3 L10,13 M6,7 L10,3 L14,7"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0"
                            Click="ImportThemeButton_Click"/>

                    <Button x:Name="RestartButton"
                            Tag="M17,7 A7,7 0 1 0 17,15 M17,7 L17,2 M17,7 L12,7"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0" Background="#20D55263"
                            BorderBrush="#66D55263" BorderThickness="1" Foreground="#D43F53"
                            Click="RestartButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#001225"/>
                        </Button.Effect>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RestartButtonText" Text="Restart L-Connect" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- Apply All â€“ solid blue accent (highlight button) -->
                    <Button x:Name="ApplyAllButton"
                            Tag="M3,10 L8,15 L18,4"
                            Style="{DynamicResource ToolbarIconButton}"
                            BorderThickness="0"
                            Click="ApplyAllButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF1A6CD8" Offset="0"/>
                                <GradientStop Color="#FF246FF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ApplyAllButtonText" Text="Apply All"
                                           VerticalAlignment="Center" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <TextBlock x:Name="SupporterPathText" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Grid.RowSpan="3" Margin="0"
                    Style="{DynamicResource MainTabControlStyle}"
                    ItemContainerStyle="{DynamicResource MainTabItemStyle}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="EditorTab" Header="Editor">
        <Grid Margin="0,66,0,0">
            <Grid Grid.Column="0" Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="270"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="470" MinWidth="420"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource Card}"
                        BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="1"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource GlassToolbarBrush}" BorderBrush="{DynamicResource GlassShimmerBrush}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" Padding="16,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Width="4" Height="18" Fill="{DynamicResource BrAccent}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="LayersHeaderText" Text="Layers" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorder}"
                                            BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="LayerCountText" Text="0 layers"
                                                   Foreground="{DynamicResource BrTextTertiary}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="CreateLayerGroupButton" Style="{DynamicResource LayerIconActionButton}"
                                            Width="34" Height="34" Margin="0,0,8,0" ToolTip="Group selected layers"
                                            Click="CreateLayerGroupButton_Click">
                                        <Path Data="M3,6 H9 L11,9 H25 V24 H3 Z M7,13 H21 M7,17 H18"
                                              Stroke="{DynamicResource BrTextPrimary}" Fill="Transparent" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="20" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="AddLayerMenuButton" Style="{DynamicResource BtnPrimary}"
                                            Width="112" MinWidth="112" Height="34" Padding="12,0"
                                            Click="AddLayerMenuButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="+" FontSize="19" FontWeight="Normal" Foreground="White"
                                                       VerticalAlignment="Center" Margin="0,-2,7,0"/>
                                            <TextBlock x:Name="AddLayerMenuButtonText" Text="Add Layer" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Popup x:Name="AddLayerMenuPopup" PlacementTarget="{Binding ElementName=AddLayerMenuButton}"
                                           Placement="Bottom" HorizontalOffset="-222"
                                           StaysOpen="False" AllowsTransparency="True">
                                        <Border Width="390" Background="{DynamicResource GlassPopupBrush}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1"
                                                CornerRadius="14" Padding="16" Margin="0,10,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270"
                                                                  Color="#000000" Opacity="0.45"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid Margin="6,2,6,12">
                                                    <StackPanel>
                                                        <TextBlock x:Name="AddLayerPopupTitleText" Text="Add Layer" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="AddLayerPopupDescText" Text="Choose content for the canvas." Margin="0,4,0,0"
                                                                   FontSize="10.5" Foreground="{DynamicResource BrTextTertiary}"/>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Width="28" Height="28" CornerRadius="8" Background="{DynamicResource BrSurface2}">
                                                        <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource BrAccentHover}"/>
                                                    </Border>
                                                </Grid>
                                                <UniformGrid Columns="2">
                                                    <Button Tag="Animation" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#7C3AED" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M10,6 L26,16 L10,26 Z" Fill="White" Stretch="Uniform" Width="16" Height="16"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock x:Name="AddLayerAnimationTitle" Text="Animation" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerAnimationDesc" Text="Background media" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Text" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#DC2626" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M6,7 H26 V11 H20 V26 H12 V11 H6 Z" Fill="White" Stretch="Uniform" Width="18" Height="18"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AddLayerTextTitle" Text="Text" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerTextDesc" Text="Static content" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Data" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#06B6D4" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M5,25 V18 H11 V25 Z M13,25 V9 H19 V25 Z M21,25 V14 H27 V25 Z" Fill="White" Stretch="Uniform" Width="18" Height="18"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AddLayerDataTitle" Text="Data" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerDataDesc" Text="Live sensor value" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Image" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#16A34A" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M5,7 H27 V25 H5 Z M8,22 L14,15 L18,19 L22,13 L27,22 Z M10,11 A2,2 0 1 1 9.9,11" Fill="White" Stretch="Uniform" Width="19" Height="19"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AddLayerImageTitle" Text="Image" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerImageDesc" Text="PNG or JPG" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="Gauge" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#F59E0B" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M16,5 A11,11 0 1 1 15.9,5 M16,9 V16 L21,19" Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="19" Height="19"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Gauge" FontWeight="SemiBold"/><TextBlock Text="Rotating gauge needle" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="StatusBar" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#EA7C17" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M4,12 H10 V20 H4 Z M12,12 H18 V20 H12 Z M20,12 H26 V20 H20 Z M28,12 H30 V20 H28 Z" Fill="White" Stretch="Uniform" Width="20" Height="14"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock x:Name="AddLayerStatusBarTitle" Text="Status Bar" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerStatusBarDesc" Text="Segmented bar" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="DynamicStatus" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Border Width="32" Height="32" CornerRadius="9" Background="#0D9488" BorderBrush="#42FFFFFF" BorderThickness="1"><Path Data="M5,14 H27 V18 H5 Z M18,9 H23 V23 H18 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock x:Name="AddLayerDynamicStatusTitle" Text="Dynamic Status" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerDynamicStatusDesc" Text="Slider style bar" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Tag="CurvedBar" Style="{DynamicResource LayerTypeChoiceButton}" Click="AddLayerChoice_Click">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
