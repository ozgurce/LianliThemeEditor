                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="16" CornerRadius="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrSurface2}"
                                    BorderBrush="{DynamicResource BrBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="Devices"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="GalleryFilterHydroshiftSCheck" Content="Hydroshift II LCD-S" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterHydroshiftCCheck" Content="Hydroshift II LCD-C" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterUniversal88Check" Content="8.8&quot; Universal Screen" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterVm92Check" Content="VM 9.2 LCD" IsChecked="True" Margin="0,0,0,16" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>

                                    <TextBlock Text="Rating"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="GalleryRatingFilterCombo"
                                              Height="30"
                                              SelectedIndex="0"
                                              SelectionChanged="GalleryComboFilter_Changed"
                                              Margin="0,0,0,16">
                                        <ComboBoxItem Content="All ratings" Tag="0"/>
                                        <ComboBoxItem Content="5 stars" Tag="5"/>
                                        <ComboBoxItem Content="4+ stars" Tag="4"/>
                                        <ComboBoxItem Content="3+ stars" Tag="3"/>
                                        <ComboBoxItem Content="2+ stars" Tag="2"/>
                                        <ComboBoxItem Content="Rated only" Tag="1"/>
                                    </ComboBox>

                                    <TextBlock Text="Sort"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="GallerySortCombo"
                                              Height="30"
                                              SelectedIndex="0"
                                              SelectionChanged="GalleryComboFilter_Changed">
                                        <ComboBoxItem Content="Default order" Tag="default"/>
                                        <ComboBoxItem Content="Most downloaded" Tag="downloads"/>
                                        <ComboBoxItem Content="Highest rated" Tag="rating"/>
                                        <ComboBoxItem Content="Most votes" Tag="votes"/>
                                        <ComboBoxItem Content="Name A-Z" Tag="name"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="GalleryEmptyText"
                                       Grid.Column="1"
                                       Text="Loading gallery..."
                                       Foreground="{DynamicResource BrTextTertiary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <ScrollViewer x:Name="GalleryScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" ScrollChanged="GalleryScrollViewer_ScrollChanged">
                                <ItemsControl x:Name="GalleryItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}" Margin="0,0,14,14"
                                                    Background="{DynamicResource BrSurface2}"
                                                    BorderBrush="{DynamicResource BrBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Opacity" Value="0.58"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding PreviewHeight}"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="Black"
                                                            BorderBrush="{DynamicResource BrBorder}"
                                                            BorderThickness="0,0,0,1"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="GalleryPreview_MouseLeftButtonUp">
                                                        <Grid>
                                                            <Image Source="{Binding Preview}" Stretch="{Binding PreviewStretch}"/>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,8,8,0"
                                                                    Padding="8,3"
                                                                    CornerRadius="7"
                                                                    Background="#9908142A"
                                                                    BorderBrush="#4045A0FF"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding AspectLabel}"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrTextSecondary}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="1" Margin="12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="6"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="34"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="22"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Author, StringFormat=Author: {0}}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource BrTextSecondary}"
                                                                   FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="18"/>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding DeviceName}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource BrTextTertiary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="18"/>
                                                        <Grid Grid.Row="3" Margin="0,7,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding StatsText}"
                                                                           Foreground="{DynamicResource BrTextSecondary}"
                                                                           FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                    <TextBlock Text="{Binding AverageStars}"
                                                                               Foreground="#FFFFC83D"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding RatingText}"
                                                                               Margin="6,0,0,0"
                                                                               Foreground="{DynamicResource BrTextTertiary}"
                                                                               FontSize="10"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <Button Content="{Binding VoteStar1}" Tag="1" Width="18" Height="22" MinWidth="18" Padding="0" FontSize="12.5" Foreground="#FFFFC83D" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" CommandParameter="{Binding}"/>
                                                                <Button Content="{Binding VoteStar2}" Tag="2" Width="18" Height="22" MinWidth="18" Padding="0" FontSize="12.5" Foreground="#FFFFC83D" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                <Button Content="{Binding VoteStar3}" Tag="3" Width="18" Height="22" MinWidth="18" Padding="0" FontSize="12.5" Foreground="#FFFFC83D" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                <Button Content="{Binding VoteStar4}" Tag="4" Width="18" Height="22" MinWidth="18" Padding="0" FontSize="12.5" Foreground="#FFFFC83D" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                <Button Content="{Binding VoteStar5}" Tag="5" Width="18" Height="22" MinWidth="18" Padding="0" FontSize="12.5" Foreground="#FFFFC83D" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Grid.Row="6"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Height="7"
                                                                     Value="{Binding Progress}"/>
                                                        <Grid Grid.Row="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Status}"
                                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,8,0"/>
                                                            <Button Grid.Column="1"
                                                                    Content="Details"
                                                                    Style="{DynamicResource BtnGhost}"
                                                                    Height="32"
                                                                    Padding="12,0"
                                                                    MinWidth="74"
                                                                    Click="GalleryDetailsButton_Click"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="3"
                                                                    Content="{Binding DownloadButtonText}"
                                                                    Style="{DynamicResource BtnPrimary}"
                                                                    Height="32"
                                                                    Padding="14,0"
                                                                    MinWidth="88"
                                                                    Click="GalleryDownloadButton_Click"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="Settings">
                <Grid Margin="0">
                    <Border Style="{DynamicResource Card}" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="22" Fill="{DynamicResource BrAccent}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Choose how the editor behaves." Foreground="{DynamicResource BrTextTertiary}" FontSize="11.5"/>
                                </StackPanel>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,22,0,0">
                                <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,12,12">
                                    <StackPanel><TextBlock Text="Layer grouping" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Show saved groups in the layer list." Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource BrTextTertiary}"/><CheckBox x:Name="GroupingEnabledCheckBox" Content="Enabled" IsChecked="True" Checked="GroupingEnabledCheckBox_Changed" Unchecked="GroupingEnabledCheckBox_Changed"/></StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,12,12">
