                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Opacity" Value="0.58"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding PreviewHeight}"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="Black"
                                                            BorderBrush="{DynamicResource BrBorder}"
                                                            BorderThickness="0,0,0,1"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="GalleryPreview_MouseLeftButtonUp">
                                                        <Grid>
                                                            <Image Source="{Binding Preview}" Stretch="{Binding PreviewStretch}"/>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Margin="8,8,0,0"
                                                                    Padding="7,3"
                                        CornerRadius="5"
                                                                    Background="#B008142A"
                                                                    BorderBrush="#40354970"
                                                                    BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="★" Tag="1" Width="18" Height="20" MinWidth="18" Padding="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding AverageStar1Brush}" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" MouseEnter="GalleryVoteStar_MouseEnter" MouseLeave="GalleryVoteStar_MouseLeave" CommandParameter="{Binding}"/>
                                                                    <Button Content="★" Tag="2" Width="18" Height="20" MinWidth="18" Padding="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding AverageStar2Brush}" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" MouseEnter="GalleryVoteStar_MouseEnter" MouseLeave="GalleryVoteStar_MouseLeave" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                    <Button Content="★" Tag="3" Width="18" Height="20" MinWidth="18" Padding="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding AverageStar3Brush}" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" MouseEnter="GalleryVoteStar_MouseEnter" MouseLeave="GalleryVoteStar_MouseLeave" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                    <Button Content="★" Tag="4" Width="18" Height="20" MinWidth="18" Padding="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding AverageStar4Brush}" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" MouseEnter="GalleryVoteStar_MouseEnter" MouseLeave="GalleryVoteStar_MouseLeave" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                    <Button Content="★" Tag="5" Width="18" Height="20" MinWidth="18" Padding="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding AverageStar5Brush}" Style="{DynamicResource BtnGhost}" Click="GalleryVoteButton_Click" MouseEnter="GalleryVoteStar_MouseEnter" MouseLeave="GalleryVoteStar_MouseLeave" CommandParameter="{Binding}" Margin="1,0,0,0"/>
                                                                    <Rectangle Width="1" Height="14" Fill="#55354970" Margin="8,0,7,0"/>
                                                                    <Path Data="M10,3 V12 M6,8 L10,12 L14,8 M5,15 H15"
                                                                          Width="14"
                                                                          Height="14"
                                                                          Stretch="Uniform"
                                                                          Stroke="{DynamicResource BrTextSecondary}"
                                                                          StrokeThickness="1.8"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DownloadCountText}"
                                                                               Margin="5,0,0,0"
                                                                               Foreground="{DynamicResource BrTextSecondary}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,8,8,0"
                                                                    Padding="8,3"
                                        CornerRadius="5"
                                                                    Background="#9908142A"
                                                                    BorderBrush="#4045A0FF"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding AspectLabel}"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrTextSecondary}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="1" Margin="12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="34"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="22"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding AuthorText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource BrTextSecondary}"
                                                                   FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="18"/>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding DeviceName}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource BrTextTertiary}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="18"/>
                                                        <ProgressBar Grid.Row="4"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Height="7"
                                                                     Value="{Binding Progress}"/>
                                                        <Grid Grid.Row="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Status}"
                                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,8,0"/>
                                                            <Button Grid.Column="1"
                                                                    Content="{Binding DownloadButtonText}"
                                                                    Style="{DynamicResource BtnPrimary}"
                                                                    Height="32"
                                                                    Padding="14,0"
                                                                    MinWidth="88"
                                                                    Click="GalleryDownloadButton_Click"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border x:Name="GalleryPaginationPanel"
                                        Grid.Row="1"
                                        Background="{DynamicResource BrSurface2}"
                                        BorderBrush="{DynamicResource BrBorder}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,6,0,0">
                                    <Grid>
                                        <TextBlock x:Name="GalleryPageSummaryText"
                                                   Text="Showing 0 themes"
                                                   Foreground="{DynamicResource BrTextTertiary}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="GalleryPreviousPageButton"
                                                    Content="Previous"
                                                    Style="{DynamicResource BtnGhost}"
                                                    Height="30"
                                                    MinWidth="86"
                                                    Padding="12,0"
                                                    Click="GalleryPreviousPageButton_Click"/>
                                            <ComboBox x:Name="GalleryPageCombo"
                                                      Width="92"
                                                      Height="30"
                                                      Margin="12,0,6,0"
                                                      SelectionChanged="GalleryPageCombo_SelectionChanged"/>
                                            <TextBlock x:Name="GalleryPageTotalText"
                                                       Text="/ 1"
                                                       Foreground="{DynamicResource BrTextSecondary}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,12,0"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="GalleryNextPageButton"
                                                    Content="Next"
                                                    Style="{DynamicResource BtnGhost}"
                                                    Height="30"
                                                    MinWidth="86"
                                                    Padding="12,0"
                                                    Click="GalleryNextPageButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="LocalThemesTab" Header="Installed Themes">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Rectangle Grid.Row="0" Height="1" Margin="970,0,0,0"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top"
                               Fill="{DynamicResource GlassAccentBorderBrush}"
                               IsHitTestVisible="False" Panel.ZIndex="2"/>
                    <Border Grid.Row="0" Background="{DynamicResource GlassToolbarBrush}"
                            BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="1,0,1,1"
                            Padding="16,0" CornerRadius="6,6,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="4" Height="20" Fill="{DynamicResource BrAccent}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="LocalThemesTitleText" Text="Installed Themes" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LocalThemesCountText" Text="Installed templates"
                                               FontSize="10.5" Foreground="{DynamicResource BrTextTertiary}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="LocalThemeSearchBox"
                                         Width="260"
                                         Height="32"
                                         Margin="0,0,10,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="LocalThemeFilter_Changed"/>
                                <Button x:Name="RefreshLocalThemesButton"
                                        Content="Refresh"
                                        Style="{DynamicResource ToolbarIconButton}"
                                        Tag="M17,7 A7,7 0 1 0 17,15 M17,7 L17,2 M17,7 L12,7"
                                        Click="RefreshLocalThemesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="16" CornerRadius="0,0,5,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrSurface2}"
                                    BorderBrush="{DynamicResource BrBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="Devices"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="LocalFilterHydroshiftSCheck" Content="Hydroshift II LCD-S" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterHydroshiftCCheck" Content="Hydroshift II LCD-C" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterUniversal88Check" Content="8.8&quot; Universal Screen" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterVm92Check" Content="VM 9.2 LCD" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterOledCurveCheck" Content="HydroShift II OLED Curve" IsChecked="True" Margin="0,0,0,16" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>

                                    <TextBlock Text="Orientation"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="LocalFilterLandscapeCheck" Content="Landscape" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterPortraitCheck" Content="Portrait" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterAutoCheck" Content="Auto" IsChecked="True" Margin="0,0,0,16" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>

                                    <TextBlock x:Name="LocalThemesSourceFilterText" Text="Source"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="LocalFilterOfficialCheck" Content="Official" IsChecked="True" Margin="0,0,0,6" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>
                                    <CheckBox x:Name="LocalFilterCustomCheck" Content="Custom" IsChecked="True" Margin="0,0,0,16" Checked="LocalThemeFilter_Changed" Unchecked="LocalThemeFilter_Changed"/>

                                    <TextBlock x:Name="LocalThemesSortFilterText" Text="Sort"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="LocalThemeSortCombo"
                                              Height="30"
                                              SelectedIndex="0"
                                              SelectionChanged="LocalThemeSortCombo_SelectionChanged">
                                        <ComboBoxItem Content="Name A-Z" Tag="name"/>
                                        <ComboBoxItem Content="Device" Tag="device"/>
                                        <ComboBoxItem Content="Custom first" Tag="custom"/>
                                        <ComboBoxItem Content="Newest" Tag="newest"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="LocalThemesEmptyText"
                                       Grid.Column="1"
                                       Text="No themes match the filters."
                                       Foreground="{DynamicResource BrTextTertiary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LocalThemesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding LocalCardWidth}" Height="{Binding LocalCardHeight}" Margin="0,0,14,14"
                                                    Background="{DynamicResource BrSurface2}"
                                                    BorderBrush="{DynamicResource BrBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding LocalCardPreviewHeight}"/>
                                                        <RowDefinition Height="46"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="Black"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="LocalThemePreview_MouseLeftButtonUp">
                                                        <Grid>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="{Binding LocalPreviewStretch}"
                                                                   RenderOptions.BitmapScalingMode="Fant"/>
                                                            <Rectangle VerticalAlignment="Bottom" Height="46">
                                                                <Rectangle.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#00102035" Offset="0"/>
                                                                        <GradientStop Color="#B0061224" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Rectangle.Fill>
                                                            </Rectangle>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Margin="8"
                                                                    Padding="8,3"
                                    CornerRadius="5"
                                                                    Background="#B0061224"
                                                                    BorderBrush="#453D79B8"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding OrientationDisplay}"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrTextSecondary}"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                    Margin="8"
                                                                    Padding="8,4"
                                                    CornerRadius="5"
                                                                    Background="#B0061224"
                                                                    BorderBrush="#453D79B8"
                                                                    BorderThickness="1"
                                                                    MaxWidth="250">
                                                                <TextBlock Text="{Binding Id}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrTextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="8"
                                                                    Padding="8,4"
                                                                    CornerRadius="5"
                                                                    Background="#B0061224"
                                                                    BorderBrush="#453D79B8"
                                                                    BorderThickness="1"
                                                                    MaxWidth="190">
                                                                <TextBlock Text="{Binding DeviceName}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrTextSecondary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="8"
                                                                    Padding="8,3"
                                                                    CornerRadius="5"
                                                                    Background="#B0061224"
                                                                    BorderBrush="#453D79B8"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding LocalAspectLabel}"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrTextSecondary}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="1"
                                                            BorderBrush="#263D79B8"
                                                            BorderThickness="0,1,0,0"
                                                            Background="#66102543">
                                                        <Grid Margin="7,7,7,7" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="14"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0"
                                                                    Content="{Binding ApplyText}"
                                                                    Style="{DynamicResource BtnPrimary}"
                                                                    Height="32"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="LocalThemeApplyButton_Click"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="2"
                                                                    Content="{Binding DeleteText}"
                                                                    Height="32"
                                                                    HorizontalAlignment="Stretch"
                                                                    IsEnabled="{Binding CanDelete}"
                                                                    Click="LocalThemeDeleteButton_Click"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnDanger}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="ConvertFixTab" Header="Convert &amp; Fix">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Rectangle Grid.Row="0" Height="1" Margin="970,0,0,0"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top"
                               Fill="{DynamicResource GlassAccentBorderBrush}"
                               IsHitTestVisible="False" Panel.ZIndex="2"/>
                    <Border Grid.Row="0" Background="{DynamicResource GlassToolbarBrush}"
                            BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="1,0,1,1"
                            Padding="16,0" CornerRadius="6,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="20" Fill="{DynamicResource BrAccent}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Convert &amp; Fix" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Theme conversion and repair workspace. Tools will be enabled in upcoming builds."
                                           FontSize="10.5" Foreground="{DynamicResource BrTextTertiary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="16" CornerRadius="0,0,3,3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <UniformGrid Columns="2">
                                <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock x:Name="FontControlTitleText" Text="Font Control" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FontControlDescText" Text="L-Connect does not show fonts that are not installed for all users in Theme Engine. If an installed theme uses one of those fonts, the theme may not render correctly. If a shared theme includes font files, you can install them for all users from here."
                                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrTextSecondary}" FontSize="11.5"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FontControlPackagePathBox" Height="30" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                            <Button x:Name="FontControlBrowsePackageButton" Grid.Column="1" Content="Browse" Height="30" Padding="12,0" Margin="8,0,0,0" Style="{DynamicResource BtnGhost}" Click="FontControlBrowseButton_Click"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="FontControlScanButton" Content="Scan fonts" Height="30" Padding="12,0" Style="{DynamicResource BtnGhost}" Click="FontControlScanButton_Click"/>
                                            <Button x:Name="InstallFontSystemWideButton" Content="Choose font file and install system wide" Height="30" Padding="12,0" Margin="8,0,0,0" Style="{DynamicResource BtnPrimary}" Click="InstallFontSystemWideButton_Click"/>
                                        </StackPanel>
                                        <ListBox x:Name="FontControlFontList" MinHeight="160" MaxHeight="240" Margin="0,10,0,0" SelectionMode="Single" Background="#1808142A" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#243C5F86" BorderThickness="0,0,0,1" Padding="10,8" Background="#12000000">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding InstallSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="8" Height="8" CornerRadius="1" Background="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                    <TextBlock Text="{Binding FamilyName}" Foreground="{DynamicResource BrTextPrimary}" FontWeight="SemiBold" FontSize="12.5"/>
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource BrTextTertiary}" Margin="8,0,0,0" FontSize="11"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource BrTextTertiary}" FontSize="10.5" TextWrapping="Wrap" Margin="15,3,0,0"/>
                                                                <TextBlock Text="{Binding SearchText}" Foreground="{DynamicResource BrTextSecondary}" FontSize="10.5" Margin="15,6,0,0"/>
                                                                <Button Content="{Binding SearchDafontButtonText}" Height="26" Width="122" Padding="0" Margin="15,6,0,0" HorizontalAlignment="Left" Style="{DynamicResource BtnGhost}" Click="FontSearchDafontButton_Click" CommandParameter="{Binding FamilyName}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="FontControlStatusText" Text="No package selected." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrTextTertiary}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock x:Name="ThemeTestTitleText" Text="Theme Test" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ThemeTestDescText" Text="A validation workspace for checking template structure, required assets, background orientation, package references, and common L-Connect compatibility problems before sharing."
                                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrTextSecondary}" FontSize="11.5"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ThemeTestPackagePathBox" Height="30" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                            <Button x:Name="ThemeTestBrowsePackageButton" Grid.Column="1" Content="Browse" Height="30" Padding="12,0" Margin="8,0,0,0" Style="{DynamicResource BtnGhost}" Click="ThemeTestBrowseButton_Click"/>
                                        </Grid>
                                        <Button x:Name="ThemeTestRunButton" Content="Run theme test" Height="30" Padding="12,0" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource BtnPrimary}" Click="ThemeTestRunButton_Click"/>
                                        <ListBox x:Name="ThemeTestResultList" MinHeight="210" MaxHeight="300" Margin="0,10,0,0" Background="#1808142A" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#243C5F86" BorderThickness="0,0,0,1" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="94"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                                <Border Width="8" Height="8" CornerRadius="1" Background="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource BrTextTertiary}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource BrTextPrimary}" TextWrapping="Wrap" FontSize="12" FontWeight="{Binding Weight}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                                <Border Background="#2426515C" BorderBrush="#7D4FD1C5" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,12,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ConvertFix88To92TitleText" Text="8.8 to VM 9.2" FontSize="14" FontWeight="SemiBold" Foreground="#D9FFF8"/>
                                            <Border Background="#334FD1C5" BorderBrush="#884FD1C5" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock x:Name="ConvertFix88To92BetaText" Text="BETA" FontSize="10" FontWeight="Bold" Foreground="#BFFFF8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="ConvertFix88To92DescText"
                                                   Text="Import an 8.8 L-Connect ZIP and export a VM 9.2 ZIP that can be imported from L-Connect. This beta path rewrites canvas metadata and converts the background to 9.2 H.264."
                                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#B8DCD8" FontSize="11.5"/>
                                        <TextBlock x:Name="ConvertFix88To92WarningText"
                                                   Text="Only the landscape/horizontal themes are supported."
                                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFFF5A5A" FontSize="11.5" FontWeight="SemiBold"/>
                                        <Button x:Name="ConvertFix88To92Button" Content="Convert 8.8 ZIP to VM 9.2 ZIP" Height="30" Padding="12,0" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{DynamicResource BtnPrimary}" Click="ConvertFix88To92Button_Click"/>
                                        <TextBlock x:Name="ConvertFix88To92StatusText" Text="Beta converter. Test the output in L-Connect before sharing." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#93C9C3" FontSize="11"/>
                                    </StackPanel>
                                </Border>
