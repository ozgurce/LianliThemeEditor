<Window x:Class="ThemeEditorCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lian Li LCD Template Editor V 1.4"
        Width="1400"
        Height="900"
        MinWidth="1250"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="editor.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BrBg}"
        Foreground="{DynamicResource BrTextPrimary}"
        FontFamily="Segoe UI Variable Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="ColBg">#07152F</Color>
        <!-- Glass surface: very low alpha so background bleeds through -->
        <Color x:Key="ColSurface">#1A10264A</Color>
        <Color x:Key="ColSurface2">#22172E59</Color>
        <Color x:Key="ColField">#30091626</Color>
        <Color x:Key="ColBorder">#45294A7A</Color>
        <Color x:Key="ColBorderSoft">#604977B7</Color>
        <Color x:Key="ColAccent">#2478F3</Color>
        <Color x:Key="ColAccentHover">#45A0FF</Color>
        <Color x:Key="ColDanger">#963434</Color>
        <Color x:Key="ColPurple">#493B83</Color>
        <Color x:Key="ColTextPrimary">#F5F7FA</Color>
        <Color x:Key="ColTextSecondary">#C9D1D9</Color>
        <Color x:Key="ColTextTertiary">#8F9AA8</Color>
        <Color x:Key="ColHover">#30234A82</Color>

        <SolidColorBrush x:Key="BrBg" Color="#07152F"/>
        <SolidColorBrush x:Key="BrSurface" Color="{StaticResource ColSurface}"/>
        <SolidColorBrush x:Key="BrSurface2" Color="{StaticResource ColSurface2}"/>
        <SolidColorBrush x:Key="BrField" Color="{StaticResource ColField}"/>
        <SolidColorBrush x:Key="BrSelectionField" Color="#FF0B1B38"/>
        <SolidColorBrush x:Key="BrBorder" Color="{StaticResource ColBorder}"/>
        <SolidColorBrush x:Key="BrBorderSoft" Color="{StaticResource ColBorderSoft}"/>
        <SolidColorBrush x:Key="BrAccent" Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentHover" Color="{StaticResource ColAccentHover}"/>
        <SolidColorBrush x:Key="BrDanger" Color="{StaticResource ColDanger}"/>
        <SolidColorBrush x:Key="BrPurple" Color="{StaticResource ColPurple}"/>
        <SolidColorBrush x:Key="BrTextPrimary" Color="{StaticResource ColTextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource ColTextSecondary}"/>
        <SolidColorBrush x:Key="BrTextTertiary" Color="{StaticResource ColTextTertiary}"/>
        <SolidColorBrush x:Key="BrHover" Color="{StaticResource ColHover}"/>
        <SolidColorBrush x:Key="BrSelectedLayer" Color="#70246FF2"/>
        <SolidColorBrush x:Key="BrGridHeader" Color="#202630"/>
        <SolidColorBrush x:Key="BrGridRow" Color="#151A22"/>
        <SolidColorBrush x:Key="BrGridAltRow" Color="#181D26"/>
        <SolidColorBrush x:Key="BrGridCellBorder" Color="#252B35"/>
        <SolidColorBrush x:Key="BrDecor1" Color="#253E91FF"/>
        <SolidColorBrush x:Key="BrDecor2" Color="#214A53D8"/>
        <SolidColorBrush x:Key="BrDecor3" Color="#1826C6A5"/>
        <SolidColorBrush x:Key="BrDecorStroke" Color="#1E68A8FF"/>
        <SolidColorBrush x:Key="BrLockBackground" Color="#32FFB72E"/>
        <SolidColorBrush x:Key="BrLockBorder" Color="#90FFCB45"/>
        <SolidColorBrush x:Key="BrLockIcon" Color="#FFFFD15A"/>
        <!-- TRUE glassmorphism panel: slightly more opaque so panels are visible but still translucent -->
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#550D2040" Offset="0"/>
            <GradientStop Color="#420A1A35" Offset="0.52"/>
            <GradientStop Color="#580D2040" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ExpanderGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#240D2040" Offset="0"/>
            <GradientStop Color="#180A1A35" Offset="0.52"/>
            <GradientStop Color="#280D2040" Offset="1"/>
        </LinearGradientBrush>
        <!-- Bright top-edge shimmer line for glass cards -->
        <LinearGradientBrush x:Key="GlassShimmerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#005080B0" Offset="0"/>
            <GradientStop Color="#505080B0" Offset="0.3"/>
            <GradientStop Color="#705488C8" Offset="0.5"/>
            <GradientStop Color="#505080B0" Offset="0.7"/>
            <GradientStop Color="#005080B0" Offset="1"/>
        </LinearGradientBrush>
        <!-- Title bar: deep, semi-transparent glass -->
        <LinearGradientBrush x:Key="GlassHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E0060E20" Offset="0"/>
            <GradientStop Color="#C0040C1A" Offset="0.5"/>
            <GradientStop Color="#E0060E20" Offset="1"/>
        </LinearGradientBrush>
        <!-- Toolbar row glass -->
        <LinearGradientBrush x:Key="GlassToolbarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D00B1F3E" Offset="0"/>
            <GradientStop Color="#B0071528" Offset="0.5"/>
            <GradientStop Color="#D00B1F3E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPopupBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0122D58" Offset="0"/>
            <GradientStop Color="#D50B2348" Offset="0.55"/>
            <GradientStop Color="#E2143563" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlassBackgroundBrush" Center="0.24,0.05" GradientOrigin="0.24,0.05" RadiusX="1.15" RadiusY="1.15">
            <GradientStop Color="#243D7B" Offset="0"/>
            <GradientStop Color="#102956" Offset="0.35"/>
            <GradientStop Color="#07162F" Offset="1"/>
        </RadialGradientBrush>
        <!-- Glassmorphism accent brushes -->
        <LinearGradientBrush x:Key="GlassAccentBorderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#401A4A8C" Offset="0"/>
            <GradientStop Color="#802478F3" Offset="0.45"/>
            <GradientStop Color="#401A4A8C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerSeparatorBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#001A4A8C" Offset="0"/>
            <GradientStop Color="#602478F3" Offset="0.35"/>
            <GradientStop Color="#802478F3" Offset="0.65"/>
            <GradientStop Color="#001A4A8C" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="ShadowCard" BlurRadius="28" ShadowDepth="2" Direction="270" Color="#000820" Opacity="0.55"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}"/>
            <!-- Glass border: top/left slightly brighter for light refraction effect -->
            <Setter Property="BorderBrush" Value="{DynamicResource GlassShimmerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowCard}"/>
        </Style>

        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="2"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#1A071A35"
                                    BorderBrush="#263B82F6"
                                    BorderThickness="0,0,0,1"
                                    Padding="18,0,18,0">
                                <TabPanel x:Name="PART_TabPanel" IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent"
                                          VerticalAlignment="Bottom"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="2"
                                              Margin="16,0,16,0"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,4,0">
                            <Border x:Name="Shadow"
                                    Height="{TemplateBinding Height}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="12,12,0,0"
                                    Background="#15000000"
                                    Opacity="0"/>
                            <Border x:Name="Root"
                                    Height="{TemplateBinding Height}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    VerticalAlignment="Bottom"
                                    Padding="{TemplateBinding Padding}"
                                    Background="#2A0B1D3A"
                                    BorderBrush="#284B76B1"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="12,12,0,0"
                                    Opacity="0.86"
                                    RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="RootSlide" Y="4"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <Rectangle x:Name="TopAccent"
                                               Height="3"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Fill="{DynamicResource BrAccent}"
                                               VerticalAlignment="Top"
                                               Margin="18,0,18,0"
                                               Opacity="0"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="0,3,0,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <!-- Aktif sekmeyi alt içerik alanına bağlayan kapak şeridi -->
                            <Rectangle x:Name="BottomCover"
                                       Height="3"
                                       VerticalAlignment="Bottom"
                                       Margin="1,0,1,-2"
                                       Fill="{DynamicResource GlassPanelBrush}"
                                       Panel.ZIndex="20"
                                       Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource GlassPanelBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassShimmerBrush}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                                <Setter Property="Panel.ZIndex" Value="5"/>
                                <Setter TargetName="BottomCover" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootSlide"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="TopAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootSlide"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="RootScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.86" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="TopAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#3A173663"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4C60A5FA"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootSlide"
                                                             Storyboard.TargetProperty="Y"
                                                             To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootSlide"
                                                             Storyboard.TargetProperty="Y"
                                                             To="4" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.86" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="38" Height="20" Margin="0,0,7,0">
                                <Border x:Name="Track"
                                        CornerRadius="10"
                                        Background="{DynamicResource BrSurface2}"
                                        BorderBrush="{DynamicResource BrBorder}"
                                        BorderThickness="1"/>
                                <Ellipse x:Name="Thumb"
                                         Width="14"
                                         Height="14"
                                         Fill="{DynamicResource BrTextTertiary}"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrAccent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource BrField}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrTextPrimary}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BrField}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource BrField}"
                                                BorderBrush="{DynamicResource BrBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Path Fill="{DynamicResource BrTextTertiary}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectionContent"
                                              Margin="10,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBlock x:Name="EditableTextDisplay"
                                       Margin="10,0,32,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrTextPrimary}"
                                       Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="{DynamicResource BrSurface2}"
                                        BorderBrush="{DynamicResource BrBorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1">
                                        <ScrollViewer MaxHeight="260" Padding="4">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="EditableTextDisplay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass button style for Export/Restart/Apply in header toolbar -->
        <Style x:Key="GlassHeaderBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#28152D55"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#50496E9F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="InteractionRoot">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <Border x:Name="HoverGlow"
                                    Background="#1645A0FF"
                                    BorderBrush="#6045A0FF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
