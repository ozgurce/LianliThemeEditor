<Window x:Class="ThemeEditorCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lian Li LCD Template Editor"
        Width="1400"
        Height="900"
        MinWidth="1250"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="editor.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BrBg}"
        Foreground="{DynamicResource BrTextPrimary}"
        FontFamily="Segoe UI Variable Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="ColBg">#07152F</Color>
        <!-- Glass surface: very low alpha so background bleeds through -->
        <Color x:Key="ColSurface">#1A10264A</Color>
        <Color x:Key="ColSurface2">#22172E59</Color>
        <Color x:Key="ColField">#30091626</Color>
        <Color x:Key="ColBorder">#45294A7A</Color>
        <Color x:Key="ColBorderSoft">#604977B7</Color>
        <Color x:Key="ColAccent">#2478F3</Color>
        <Color x:Key="ColAccentHover">#45A0FF</Color>
        <Color x:Key="ColDanger">#963434</Color>
        <Color x:Key="ColPurple">#493B83</Color>
        <Color x:Key="ColTextPrimary">#F5F7FA</Color>
        <Color x:Key="ColTextSecondary">#C9D1D9</Color>
        <Color x:Key="ColTextTertiary">#8F9AA8</Color>
        <Color x:Key="ColHover">#30234A82</Color>

        <SolidColorBrush x:Key="BrBg" Color="#07152F"/>
        <SolidColorBrush x:Key="BrSurface" Color="{StaticResource ColSurface}"/>
        <SolidColorBrush x:Key="BrSurface2" Color="{StaticResource ColSurface2}"/>
        <SolidColorBrush x:Key="BrField" Color="{StaticResource ColField}"/>
        <SolidColorBrush x:Key="BrSelectionField" Color="#FF0B1B38"/>
        <SolidColorBrush x:Key="BrBorder" Color="{StaticResource ColBorder}"/>
        <SolidColorBrush x:Key="BrBorderSoft" Color="{StaticResource ColBorderSoft}"/>
        <SolidColorBrush x:Key="BrAccent" Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentHover" Color="{StaticResource ColAccentHover}"/>
        <SolidColorBrush x:Key="BrDanger" Color="{StaticResource ColDanger}"/>
        <SolidColorBrush x:Key="BrPurple" Color="{StaticResource ColPurple}"/>
        <SolidColorBrush x:Key="BrTextPrimary" Color="{StaticResource ColTextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource ColTextSecondary}"/>
        <SolidColorBrush x:Key="BrTextTertiary" Color="{StaticResource ColTextTertiary}"/>
        <SolidColorBrush x:Key="BrHover" Color="{StaticResource ColHover}"/>
        <SolidColorBrush x:Key="BrSelectedLayer" Color="#70246FF2"/>
        <SolidColorBrush x:Key="BrGridHeader" Color="#202630"/>
        <SolidColorBrush x:Key="BrGridRow" Color="#151A22"/>
        <SolidColorBrush x:Key="BrGridAltRow" Color="#181D26"/>
        <SolidColorBrush x:Key="BrGridCellBorder" Color="#252B35"/>
        <SolidColorBrush x:Key="BrDecor1" Color="#253E91FF"/>
        <SolidColorBrush x:Key="BrDecor2" Color="#214A53D8"/>
        <SolidColorBrush x:Key="BrDecor3" Color="#1826C6A5"/>
        <SolidColorBrush x:Key="BrDecorStroke" Color="#1E68A8FF"/>
        <SolidColorBrush x:Key="BrLockBackground" Color="#32FFB72E"/>
        <SolidColorBrush x:Key="BrLockBorder" Color="#90FFCB45"/>
        <SolidColorBrush x:Key="BrLockIcon" Color="#FFFFD15A"/>
        <!-- TRUE glassmorphism panel: slightly more opaque so panels are visible but still translucent -->
        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#550D2040" Offset="0"/>
            <GradientStop Color="#420A1A35" Offset="0.52"/>
            <GradientStop Color="#580D2040" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ExpanderGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#240D2040" Offset="0"/>
            <GradientStop Color="#180A1A35" Offset="0.52"/>
            <GradientStop Color="#280D2040" Offset="1"/>
        </LinearGradientBrush>
        <!-- Bright top-edge shimmer line for glass cards -->
        <LinearGradientBrush x:Key="GlassShimmerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#005080B0" Offset="0"/>
            <GradientStop Color="#505080B0" Offset="0.3"/>
            <GradientStop Color="#705488C8" Offset="0.5"/>
            <GradientStop Color="#505080B0" Offset="0.7"/>
            <GradientStop Color="#005080B0" Offset="1"/>
        </LinearGradientBrush>
        <!-- Title bar: deep, semi-transparent glass -->
        <LinearGradientBrush x:Key="GlassHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E0060E20" Offset="0"/>
            <GradientStop Color="#C0040C1A" Offset="0.5"/>
            <GradientStop Color="#E0060E20" Offset="1"/>
        </LinearGradientBrush>
        <!-- Toolbar row glass -->
        <LinearGradientBrush x:Key="GlassToolbarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D00B1F3E" Offset="0"/>
            <GradientStop Color="#B0071528" Offset="0.5"/>
            <GradientStop Color="#D00B1F3E" Offset="1"/>
        </LinearGradientBrush>
        <!-- Solid background brush for tab bottom cover to hide top border completely -->
        <LinearGradientBrush x:Key="SolidToolbarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0B1F3E" Offset="0"/>
            <GradientStop Color="#FF071528" Offset="0.5"/>
            <GradientStop Color="#FF0B1F3E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPopupBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0122D58" Offset="0"/>
            <GradientStop Color="#D50B2348" Offset="0.55"/>
            <GradientStop Color="#E2143563" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlassBackgroundBrush" Center="0.24,0.05" GradientOrigin="0.24,0.05" RadiusX="1.15" RadiusY="1.15">
            <GradientStop Color="#243D7B" Offset="0"/>
            <GradientStop Color="#102956" Offset="0.35"/>
            <GradientStop Color="#07162F" Offset="1"/>
        </RadialGradientBrush>
        <!-- Glassmorphism accent brushes -->
        <LinearGradientBrush x:Key="GlassAccentBorderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#401A4A8C" Offset="0"/>
            <GradientStop Color="#802478F3" Offset="0.45"/>
            <GradientStop Color="#401A4A8C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerSeparatorBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#001A4A8C" Offset="0"/>
            <GradientStop Color="#602478F3" Offset="0.35"/>
            <GradientStop Color="#802478F3" Offset="0.65"/>
            <GradientStop Color="#001A4A8C" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="ShadowCard" BlurRadius="28" ShadowDepth="2" Direction="270" Color="#000820" Opacity="0.55"/>

        <LinearGradientBrush x:Key="SwitchOnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF19EA55" Offset="0"/>
            <GradientStop Color="#FF00C944" Offset="0.58"/>
            <GradientStop Color="#FF00A936" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SwitchOffBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD4D8DE" Offset="0"/>
            <GradientStop Color="#FFAEB5BE" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="SwitchThumbOnBrush" GradientOrigin="0.36,0.25" Center="0.48,0.44" RadiusX="0.72" RadiusY="0.72">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFF1F3F5" Offset="0.68"/>
            <GradientStop Color="#FFD5DADF" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="SwitchThumbOffBrush" GradientOrigin="0.34,0.24" Center="0.48,0.44" RadiusX="0.72" RadiusY="0.72">
            <GradientStop Color="#FFE2E6EA" Offset="0"/>
            <GradientStop Color="#FFBCC3CB" Offset="0.62"/>
            <GradientStop Color="#FF919AA5" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassPanelBrush}"/>
            <!-- Glass border: top/left slightly brighter for light refraction effect -->
            <Setter Property="BorderBrush" Value="{DynamicResource GlassShimmerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowCard}"/>
        </Style>

        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54"/>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource GlassAccentBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,0,18,0"
                                    Panel.ZIndex="20">
                                <TabPanel x:Name="PART_TabPanel" IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent"
                                          VerticalAlignment="Bottom"
                                          Panel.ZIndex="20"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="2"
                                              Margin="8,-1,8,0"
                                              Panel.ZIndex="0"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,4,0">
                            <Border x:Name="Shadow"
                                    Height="{TemplateBinding Height}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="6,6,0,0"
                                    Background="#15000000"
                                    Opacity="0"/>
                            <Border x:Name="Root"
                                    Height="{TemplateBinding Height}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    VerticalAlignment="Bottom"
                                    Padding="{TemplateBinding Padding}"
                                    Background="#2A0B1D3A"
                                    BorderBrush="#284B76B1"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0"
                                    Opacity="0.86">
                                <Grid>
                                    <Rectangle x:Name="TopAccent"
                                               Height="3"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Fill="{DynamicResource BrAccent}"
                                               VerticalAlignment="Top"
                                               Margin="18,0,18,0"
                                               Opacity="0"/>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="0,3,0,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource GlassToolbarBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassShimmerBrush}"/>
                                <Setter TargetName="Root" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                                <Setter Property="Panel.ZIndex" Value="5"/>
                                <Setter Property="Height" Value="52"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="1,1,1,1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#3A173663"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4C60A5FA"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                                <Setter Property="Height" Value="47"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="44" Height="24" Margin="0,0,8,0">
                                <Border x:Name="Track"
                                        CornerRadius="12"
                                        Background="{StaticResource SwitchOffBrush}"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"/>
                                <Border x:Name="TrackHighlight"
                                        CornerRadius="12"
                                        Margin="2"
                                        VerticalAlignment="Top"
                                        Height="10"
                                        Background="#45FFFFFF"
                                        IsHitTestVisible="False"/>
                                 <Ellipse x:Name="Thumb"
                                          Width="22"
                                          Height="22"
                                          Fill="{StaticResource SwitchThumbOffBrush}"
                                          HorizontalAlignment="Left"
                                          Margin="1,0,0,0"
                                          VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="1.5" Direction="270" Opacity="0.32" Color="#10151B"/>
                                    </Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbSlide" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SwitchOnBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8822E863"/>
                                <Setter TargetName="TrackHighlight" Property="Background" Value="#35FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource SwitchThumbOnBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                             Storyboard.TargetProperty="X"
                                                              To="20" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource BrField}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrTextPrimary}"/>
        </Style>

        <Style x:Key="DeviceNameTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Foreground="{DynamicResource BrTextTertiary}"
                                           Opacity="0.62"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxTextBoxTemplate" TargetType="{x:Type TextBox}">
            <ScrollViewer x:Name="PART_ContentHost"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BrField}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Path x:Name="Arrow"
                                                      Width="8"
                                                      Height="5"
                                                      Margin="0,0,11,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Fill="{DynamicResource BrTextTertiary}"
                                                      Data="M 0 0 L 4 5 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              RecognizesAccessKey="True"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="10,0,30,0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     Focusable="True"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Template="{StaticResource ComboBoxTextBoxTemplate}"
                                     Visibility="Hidden"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource BrSelectionField}"
                                            BorderBrush="{DynamicResource BrBorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer Margin="0"
                                                      Padding="4"
                                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEditable" Value="True"/>
                                    <Condition Property="IsReadOnly" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_EditableTextBox" Property="Focusable" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="IsHitTestVisible" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="SelectionBrush" Value="Transparent"/>
                                <Setter TargetName="PART_EditableTextBox" Property="CaretBrush" Value="Transparent"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="MinHeight" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
