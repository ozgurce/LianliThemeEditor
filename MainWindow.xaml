                                <StackPanel>
                                    <TextBlock Text="When reporting a bug, include the device, the theme name, what you clicked, and whether L-Connect was running."
                                               TextWrapping="Wrap" Foreground="{DynamicResource BrTextSecondary}"/>
                                    <TextBlock Text="A screenshot or the theme package usually saves a lot of guessing."
                                               Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrTextTertiary}"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="OpenGitHubIssuesButton" Content="Open GitHub Issues"
