                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock x:Name="AddLayerChartTitle" Text="Chart" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerChartDesc" Text="Stream chart" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1" CornerRadius="10" Padding="8,4" Margin="8,7,8,3" MinHeight="82">
                            <Grid>
                                <WrapPanel ItemHeight="30">
                                    <Button x:Name="BatchEditButton" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Edit selected layers" Click="BatchEditButton_Click">
                                        <Path Data="M4,5 H18 M4,10 H18 M4,15 H18 M7,3 V7 M14,8 V12 M10,13 V17" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource BrBorder}"/>
                                    <Button Tag="Left" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Align left to canvas" Click="AlignLayersButton_Click"><Path Data="M4,3 V17 M7,5 H17 M7,10 H17 M7,15 H17" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="CenterX" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Center horizontally on canvas" Click="AlignLayersButton_Click"><Path Data="M10,3 V17 M5,5 H15 M5,10 H15 M5,15 H15" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="Right" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Align right to canvas" Click="AlignLayersButton_Click"><Path Data="M16,3 V17 M3,5 H13 M3,10 H13 M3,15 H13" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="Top" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Align top to canvas" Click="AlignLayersButton_Click"><Path Data="M3,4 H17 M5,7 V17 M10,7 V17 M15,7 V17" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="CenterY" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Center vertically on canvas" Click="AlignLayersButton_Click"><Path Data="M3,10 H17 M5,5 V15 M10,5 V15 M15,5 V15" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="Bottom" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Align bottom to canvas" Click="AlignLayersButton_Click"><Path Data="M3,16 H17 M5,3 V13 M10,3 V13 M15,3 V13" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="MatchX" Style="{DynamicResource LayerIconActionButton}" Width="78" Height="30" ToolTip="Match selected layers X" Click="AlignLayersButton_Click"><TextBlock x:Name="MatchXToolbarText" Text="Horizontal=" Foreground="{DynamicResource BrTextPrimary}" FontWeight="SemiBold" FontSize="10"/></Button>
                                    <Button Tag="MatchY" Style="{DynamicResource LayerIconActionButton}" Width="72" Height="30" ToolTip="Match selected layers Y" Click="AlignLayersButton_Click"><TextBlock x:Name="MatchYToolbarText" Text="Vertical=" Foreground="{DynamicResource BrTextPrimary}" FontWeight="SemiBold" FontSize="10"/></Button>
                                    <Button Tag="DistributeX" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Distribute horizontally across canvas" Click="AlignLayersButton_Click"><Path Data="M4,3 V17 M10,3 V17 M16,3 V17" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                    <Button Tag="DistributeY" Style="{DynamicResource LayerIconActionButton}" Width="30" Height="30" ToolTip="Distribute vertically across canvas" Click="AlignLayersButton_Click"><Path Data="M3,4 H17 M3,10 H17 M3,16 H17" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="LayerGrid" Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding LayerView}" SelectionChanged="LayerGrid_SelectionChanged" PreviewMouseLeftButtonDown="LayerGrid_PreviewMouseLeftButtonDown" ContextMenuOpening="LayerGrid_ContextMenuOpening" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False" CellEditEnding="LayerGrid_CellEditEnding" SizeChanged="LayerGrid_SizeChanged"
                                  Style="{DynamicResource LayerCardGrid}" VerticalContentAlignment="Center">
                            <DataGrid.ContextMenu>
                                <ContextMenu/>
                            </DataGrid.ContextMenu>
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <Grid ClipToBounds="False" HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Border x:Name="GroupHeader" Grid.Row="0" Margin="8,8,8,3" Padding="10,7"
                                                                    Tag="{Binding Name}" MouseLeftButtonDown="LayerGroupHeader_MouseLeftButtonDown"
                                                                    ToolTip="Click to select group layers. Double-click to rename."
                                                                    CornerRadius="9" Background="#1E246FF2"
                                                                    BorderBrush="{Binding Items[0].GroupColor}" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="24"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{Binding Items[0].GroupColor}" HorizontalAlignment="Left"/>
                                                                    <Path Grid.Column="1" Data="M3,6 H9 L11,9 H25 V23 H3 Z" Stroke="{Binding Items[0].GroupColor}"
                                                                          Fill="Transparent" StrokeThickness="1.7" Width="18" Height="16" Stretch="Uniform"/>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"/>
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat=  ({0})}" Margin="4,0,0,0"
                                                                                   Foreground="{DynamicResource BrTextTertiary}" FontSize="10"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="GroupVisibilityButton" Grid.Column="3" Style="{DynamicResource LayerIconActionButton}" Tag="{Binding Name}"
                                                                            ToolTip="Show or hide group" Click="LayerGroupVisibilityButton_Click">
                                                                        <Path Data="M2,10 C5,4 15,4 18,10 C15,16 5,16 2,10 Z M7,10 A3,3 0 1 0 13,10 A3,3 0 1 0 7,10"
                                                                              Fill="{DynamicResource BrTextPrimary}" Width="16" Height="13" Stretch="Uniform"/>
                                                                    </Button>
                                                                    <Button x:Name="GroupLockButton" Grid.Column="4" Style="{DynamicResource LayerIconActionButton}" Tag="{Binding Name}"
                                                                            ToolTip="Lock or unlock group" Click="LayerGroupLockButton_Click">
                                                                        <Path Data="M6,9 V6 A4,4 0 0 1 14,6 V9 M4,9 H16 V18 H4 Z"
                                                                              Stroke="{DynamicResource BrTextPrimary}" Fill="Transparent" StrokeThickness="1.7"
                                                                              Width="15" Height="16" Stretch="Uniform"/>
                                                                    </Button>
                                                                    <Button x:Name="GroupRemoveButton" Grid.Column="5" Style="{DynamicResource LayerIconActionButton}" Tag="{Binding Name}"
                                                                            ToolTip="Group actions" Click="LayerGroupActionsButton_Click">
                                                                        <Path Data="M4,10 A1.5,1.5 0 1 1 4,10.1 M10,10 A1.5,1.5 0 1 1 10,10.1 M16,10 A1.5,1.5 0 1 1 16,10.1" Fill="{DynamicResource BrTextPrimary}" Width="16" Height="16" Stretch="Uniform"/>
                                                                    </Button>
                                                                    <ToggleButton x:Name="GroupExpandToggle" Grid.Column="6" IsChecked="True" Tag="{Binding Name}"
                                                                                  Checked="LayerGroupExpander_Expanded"
                                                                                  Unchecked="LayerGroupExpander_Collapsed"
                                                                                  Loaded="LayerGroupExpander_Loaded"
                                                                                  Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                                                                  Cursor="Hand">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                                                                    <Grid Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                        <Rectangle Height="2.2" RadiusX="1.1" RadiusY="1.1"
                                                                                                   Fill="{DynamicResource BrTextSecondary}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                        <Rectangle x:Name="GroupExpandVerticalLine"
                                                                                                   Width="2.2" RadiusX="1.1" RadiusY="1.1"
                                                                                                   Fill="{DynamicResource BrTextSecondary}"
                                                                                                   HorizontalAlignment="Center"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="GroupExpandVerticalLine" Property="Opacity" Value="0"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>
                                                                </Grid>
                                                            </Border>
                                                            <ItemsPresenter x:Name="GroupItems" Grid.Row="1" HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger SourceName="GroupExpandToggle" Property="IsChecked" Value="False">
                                                                <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                                <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Ungrouped">
                                                                <Setter TargetName="GroupVisibilityButton" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="GroupLockButton" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="GroupRemoveButton" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="LayerCardColumn" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="LayerCard"
                                                    Margin="8,2"
                                                    Padding="8,5"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource BrSurface2}"
                                            BorderBrush="{DynamicResource BrBorderSoft}"
                                            BorderThickness="1">
                                                <Border.RenderTransform>
                                                    <TranslateTransform Y="0"/>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                                      Color="#000820" Opacity="0.40"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                        <Border x:Name="LayerTypeIcon" Grid.Column="0" Width="32" Height="32"
                                                                CornerRadius="9" Background="{Binding IconColor}"
                                                                BorderBrush="#42FFFFFF" BorderThickness="1"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                                                                  Color="{Binding IconColor}" Opacity="0.42"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Ellipse Width="22" Height="22" Fill="#12FFFFFF"/>
                                                                <Path Data="{Binding IconData}" Fill="White" Stroke="White" StrokeThickness="0.35"
                                                                      Stretch="Uniform" Width="17" Height="17"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="LayerTypeIconText" Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource BrTextPrimary}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DataSource}" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource BrTextSecondary}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Media}" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource BrTextTertiary}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button x:Name="LayerVisibilityButton" Grid.Column="2"
                                                                Style="{DynamicResource LayerIconActionButton}"
                                                                ToolTip="{Binding VisibilityTooltip}"
                                                                Click="LayerVisibilityButton_Click">
                                                            <Path x:Name="LayerVisibilityIcon"
                                                                  Data="M2,10 C5,4 15,4 18,10 C15,16 5,16 2,10 Z M7,10 A3,3 0 1 0 13,10 A3,3 0 1 0 7,10"
                                                                  Fill="{DynamicResource BrTextPrimary}" Stretch="Uniform" Width="18" Height="15"/>
                                                        </Button>
                                                        <Button x:Name="LayerLockButton" Grid.Column="3"
                                                                Style="{DynamicResource LayerIconActionButton}"
                                                                Padding="5" ToolTip="{Binding LockTooltip}"
                                                                Click="LayerLockButton_Click">
                                                            <Path x:Name="LayerLockIcon"
                                                                  Data="M6,9 V6 A4,4 0 0 1 14,6 V9 M4,9 H16 V18 H4 Z"
                                                                  Stroke="{DynamicResource BrTextPrimary}" Fill="Transparent" StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                                  Stretch="Uniform" Width="16" Height="18"/>
                                                        </Button>
                                                        <Border Grid.Column="4" Width="28" Height="24" CornerRadius="7"
                                                                Background="{DynamicResource BrField}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Index, StringFormat=\#{0}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource BrTextTertiary}" FontSize="10"/>
                                                        </Border>
                                                        <Border x:Name="DirtyBadge"
                                                                Grid.Column="4"
                                                                Width="8"
                                                                Height="8"
                                                                CornerRadius="4"
                                                                Background="#FFFFC83D"
                                                                BorderBrush="#CC000000"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-2,-1,0"
                                                                Visibility="Collapsed"
                                                                ToolTip="Unsaved changes"/>
                                                        <Border x:Name="LayerHoverWash"
                                                                Grid.ColumnSpan="5"
                                                                Background="#10FFFFFF"
                                                                BorderThickness="0"
                                                                CornerRadius="9"
                                                                Opacity="0"
                                                                IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Background" Value="{DynamicResource BrHover}"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LayerHoverWash"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.18">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LayerHoverWash"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.22">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Opacity" Value="0.92"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LayerCard"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                 To="1" Duration="0:0:0.07"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LayerCard"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                 To="0" Duration="0:0:0.11"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Hide}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Opacity" Value="0.45"/>
                                                    <Setter TargetName="LayerVisibilityIcon" Property="Opacity" Value="0.28"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter TargetName="LayerLockIcon" Property="Data" Value="M6,9 V6 A4,4 0 0 1 14,6 V9 M4,9 H16 V18 H4 Z M10,12 V15"/>
                                                    <Setter TargetName="LayerLockIcon" Property="Stroke" Value="{DynamicResource BrLockIcon}"/>
                                                    <Setter TargetName="LayerLockIcon" Property="StrokeThickness" Value="2.3"/>
                                                    <Setter TargetName="LayerLockIcon" Property="Width" Value="17"/>
                                                    <Setter TargetName="LayerLockIcon" Property="Height" Value="19"/>
                                                    <Setter TargetName="LayerLockButton" Property="Background" Value="{DynamicResource BrLockBackground}"/>
                                                    <Setter TargetName="LayerLockButton" Property="BorderBrush" Value="{DynamicResource BrLockBorder}"/>
                                                    <Setter TargetName="LayerLockButton" Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter TargetName="DirtyBadge" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Background" Value="{DynamicResource BrSelectedLayer}"/>
                                                    <Setter TargetName="LayerCard" Property="BorderBrush" Value="{DynamicResource BrAccentHover}"/>
                                                    <Setter TargetName="LayerCard" Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

                <Border Grid.Row="0" Grid.Column="4" Style="{DynamicResource Card}"
                        BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="1"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Expander Grid.Row="0" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock x:Name="EditLayerHeaderText" Text="Properties" FontSize="15" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                        <StackPanel x:Name="PropertyEditorContent" Visibility="Collapsed">
                            <Border Background="{DynamicResource BrSurface2}" BorderBrush="{DynamicResource BrBorderSoft}" BorderThickness="1"
                                    CornerRadius="9" Padding="9" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SelectedLayerIconBorder" Width="34" Height="34" CornerRadius="9"
                                            Background="#2563EB" BorderBrush="#42FFFFFF" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="SelectedLayerIconShadow" BlurRadius="12" ShadowDepth="2"
                                                              Direction="270" Color="#2563EB" Opacity="0.48"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Ellipse Width="25" Height="25" Fill="#12FFFFFF"/>
                                            <Path x:Name="SelectedLayerIconPath" Fill="White" Stroke="White" StrokeThickness="0.35"
                                                  Width="19" Height="19" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="SelectedLayerTypeText" Text="" FontWeight="SemiBold"/>
