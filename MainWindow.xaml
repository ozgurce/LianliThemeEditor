                            </Button>
                            <Button x:Name="PreviewGuidesButton" Style="{DynamicResource BtnNudge}" Margin="0,0,8,0" ToolTip="Show / hide preview guides" Click="PreviewGuidesButton_Click">
                                <Path x:Name="PreviewGuidesIcon" Data="M4,4 H16 M4,10 H16 M4,16 H16 M4,4 V16 M10,4 V16 M16,4 V16" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <StackPanel x:Name="OledCurvePreviewModePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
                                <Button x:Name="OledCurvePreviewFullButton" Tag="full" Style="{DynamicResource BtnNudge}" Margin="0,0,3,0" ToolTip="Full screen preview" Click="OledCurvePreviewModeButton_Click">
                                    <Rectangle Width="18" Height="12" RadiusX="1" RadiusY="1" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.7"/>
                                </Button>
                                <Button x:Name="OledCurvePreviewDualButton" Tag="dual" Style="{DynamicResource BtnNudge}" Margin="0,0,3,0" ToolTip="Dual split preview" Click="OledCurvePreviewModeButton_Click">
                                    <Grid Width="20" Height="12">
                                        <Rectangle RadiusX="1" RadiusY="1" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.7"/>
                                        <Line X1="13" X2="13" Y1="0" Y2="12" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.5"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="OledCurvePreviewTripleButton" Tag="triple" Style="{DynamicResource BtnNudge}" ToolTip="Triple split preview" Click="OledCurvePreviewModeButton_Click">
                                    <Grid Width="20" Height="12">
                                        <Rectangle RadiusX="1" RadiusY="1" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.7"/>
                                        <Line X1="6.7" X2="6.7" Y1="0" Y2="12" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.5"/>
                                        <Line X1="13.4" X2="13.4" Y1="0" Y2="12" Stroke="{DynamicResource BrTextPrimary}" StrokeThickness="1.5"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <Button Content="-" Style="{DynamicResource BtnNudge}" Click="CanvasZoomMinus_Click"/>
                            <Border Background="{DynamicResource BrField}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                    Padding="14,8" Margin="6,0" CornerRadius="6">
                                <TextBlock x:Name="CanvasZoomText" Text="100%" FontWeight="SemiBold"/>
                            </Border>
                            <Button Content="+" Style="{DynamicResource BtnNudge}" Click="CanvasZoomPlus_Click"/>
                            <Button x:Name="FitPreviewButton" Content="Fit"
                                    Style="{DynamicResource BtnNudge}" Width="46"
                                    Margin="8,0,0,0" ToolTip="Fit the preview to the available area"
                                    Click="FitPreviewButton_Click"/>
                            <Button x:Name="SoloLayerButton" Content="Solo"
                                    Style="{DynamicResource BtnNudge}" Width="54"
                                    Margin="8,0,0,0" ToolTip="Show only selected layer(s)"
                                    Click="SoloLayerButton_Click"/>
                            <Slider x:Name="CanvasZoomSlider"
                                    Style="{DynamicResource NumericSlider}"
                                    Width="110"
                                    Minimum="0.2"
                                    Maximum="5"
                                    Value="1.8"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CanvasZoomSlider_ValueChanged"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="Vm92DirectApplyNotice" Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="0,2,0,8"
                            Padding="12,8"
                            CornerRadius="5"
                            Background="#22F59E0B"
                            BorderBrush="#80F59E0B"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="Vm92DirectApplyNoticeText"
                                       Text="Direct apply is not supported for this screen yet. Export it as a ZIP and import it from L-Connect."
                                       Foreground="#FDE68A"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="Convert88To92Button"
                                    Content="Convert 8.8 theme to 9.2 theme"
                                    Click="Convert88To92Button_Click"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    MinHeight="30"
                                    Padding="12,5"
                                    Style="{DynamicResource ToolbarIconButton}"
                                    Tag="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,19 L17,19 L17,16"
                                    Background="#2020BFA8"
                                    BorderBrush="#6620BFA8"
                                    BorderThickness="1"
                                    Foreground="#5DE4D0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="OledCurveBetaNotice" Grid.Row="2"
                            Visibility="Collapsed"
                            Margin="0,2,0,8"
                            Padding="12,8"
                            CornerRadius="5"
                            Background="#221E90FF"
                            BorderBrush="#661E90FF"
                            BorderThickness="1">
                        <TextBlock x:Name="OledCurveBetaNoticeText"
                                   Text="OLED Curve support is in beta. Back up your theme files before editing or applying changes."
                                   Foreground="#BFE6FF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <ScrollViewer x:Name="PreviewScrollViewer" Grid.Row="3"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  CanContentScroll="False"
                                  PanningMode="Both"
                                  Margin="0,4,0,0">
                        <Border x:Name="PreviewFrame" Width="240" Height="240" Padding="0"
                                Background="Black" BorderBrush="{DynamicResource BrBorder}"
                                BorderThickness="1" CornerRadius="0" ClipToBounds="True"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="PreviewSurface" Width="240" Height="240">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="PreviewClipGeometry" Rect="0,0,240,240"/>
                                </Grid.Clip>
                                <Canvas x:Name="OledCurveSplitBackgroundCanvas" Width="240" Height="240" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <MediaElement x:Name="BackgroundMedia" Width="240" Height="240" Stretch="Fill" Volume="0" IsMuted="True" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaEnded="BackgroundMedia_MediaEnded"/>
                                <Image x:Name="BackgroundImage" Width="240" Height="240" Stretch="Fill" Visibility="Collapsed"/>
                                <Rectangle Fill="#08000000"/>
                                <Canvas x:Name="PreviewCanvas" Width="240" Height="240" Background="Transparent"
                                        Focusable="True"
                                        MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                        MouseRightButtonDown="PreviewCanvas_MouseRightButtonDown">
                                    <Canvas.ContextMenu>
                                        <ContextMenu x:Name="PreviewLayerContextMenu" Opened="PreviewLayerContextMenu_Opened">
                                            <MenuItem Header="Duplicate" Click="PreviewDuplicateMenu_Click"/>
                                            <MenuItem Header="Hide / Show" Click="PreviewHideMenu_Click"/>
                                            <MenuItem Header="Lock / Unlock" Click="PreviewLockMenu_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Bring Forward" Click="PreviewBringForwardMenu_Click"/>
                                            <MenuItem Header="Send Backward" Click="PreviewSendBackwardMenu_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Solo Selected" IsCheckable="True" Click="PreviewSoloMenu_Click"/>
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                                <Grid IsHitTestVisible="False">
                                    <Rectangle x:Name="PreviewMaskTop" Height="5" VerticalAlignment="Top" Fill="Black"/>
                                    <Rectangle x:Name="PreviewMaskBottom" Height="5" VerticalAlignment="Bottom" Fill="Black"/>
                                    <Rectangle x:Name="PreviewMaskLeft" Width="5" HorizontalAlignment="Left" Fill="Black"/>
                                    <Rectangle x:Name="PreviewMaskRight" Width="5" HorizontalAlignment="Right" Fill="Black"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
        </Grid>
            </TabItem>
            <TabItem x:Name="GalleryTab" Header="Theme Gallery">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Rectangle Grid.Row="0" Height="1" Margin="970,0,0,0"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top"
                               Fill="{DynamicResource GlassAccentBorderBrush}"
                               IsHitTestVisible="False" Panel.ZIndex="2"/>
                    <Border Grid.Row="0" Background="{DynamicResource GlassToolbarBrush}"
                            BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="1,0,1,1"
                            Padding="16,0" CornerRadius="6,6,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="4" Height="20" Fill="{DynamicResource BrAccent}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="GalleryTitleText" Text="Theme Gallery" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GallerySourceText" Text="GitHub and local templates folder"
                                               FontSize="10.5" Foreground="{DynamicResource BrTextTertiary}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="GallerySendThemesButton" Content="Send Themes"
                                        Tag="M4,4 H16 V14 H7 L4,17 V4 Z M7,7 H13 M7,10 H15"
                                        Style="{DynamicResource ToolbarIconButton}" Margin="0,0,10,0" Click="SendThemesButton_Click"/>
                                <CheckBox x:Name="GalleryActivateAfterInstallCheck"
                                          Content="Activate after install"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,14,0"/>
                                <Button x:Name="RefreshGalleryButton"
                                        Content="Refresh"
                                        Style="{DynamicResource ToolbarIconButton}"
                                        Tag="M17,7 A7,7 0 1 0 17,15 M17,7 L17,2 M17,7 L12,7"
                                        Click="RefreshGalleryButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="16" CornerRadius="0,0,5,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrSurface2}"
                                    BorderBrush="{DynamicResource BrBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock x:Name="LocalThemesDevicesFilterText" Text="Devices"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="GalleryFilterHydroshiftSCheck" Content="Hydroshift II LCD-S" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterHydroshiftCCheck" Content="Hydroshift II LCD-C" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterUniversal88Check" Content="8.8&quot; Universal Screen" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterVm92Check" Content="VM 9.2 LCD" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterOledCurveCheck" Content="HydroShift II OLED Curve" IsChecked="True" Margin="0,0,0,16" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>

                                    <TextBlock x:Name="LocalThemesOrientationFilterText" Text="Orientation"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="GalleryFilterLandscapeCheck" Content="Landscape" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterPortraitCheck" Content="Portrait" IsChecked="True" Margin="0,0,0,16" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>

                                    <TextBlock Text="Install state"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="GalleryFilterInstalledCheck" Content="Installed" IsChecked="True" Margin="0,0,0,6" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>
                                    <CheckBox x:Name="GalleryFilterNotInstalledCheck" Content="Not installed" IsChecked="True" Margin="0,0,0,16" Checked="GalleryFilter_Changed" Unchecked="GalleryFilter_Changed"/>

                                    <TextBlock Text="Rating"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="GalleryRatingFilterCombo"
                                              Height="30"
                                              SelectedIndex="0"
                                              SelectionChanged="GalleryComboFilter_Changed"
                                              Margin="0,0,0,16">
                                        <ComboBoxItem Content="All ratings" Tag="0"/>
                                        <ComboBoxItem Content="5 stars" Tag="5"/>
                                        <ComboBoxItem Content="4+ stars" Tag="4"/>
                                        <ComboBoxItem Content="3+ stars" Tag="3"/>
                                        <ComboBoxItem Content="2+ stars" Tag="2"/>
                                        <ComboBoxItem Content="Rated only" Tag="1"/>
                                    </ComboBox>

                                    <TextBlock Text="Sort"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="GallerySortCombo"
                                              Height="30"
                                              SelectedIndex="0"
                                              SelectionChanged="GalleryComboFilter_Changed">
                                        <ComboBoxItem Content="Default order" Tag="default"/>
                                        <ComboBoxItem Content="Most downloaded" Tag="downloads"/>
                                        <ComboBoxItem Content="Highest rated" Tag="rating"/>
                                        <ComboBoxItem Content="Most votes" Tag="votes"/>
                                        <ComboBoxItem Content="Name A-Z" Tag="name"/>
                                        <ComboBoxItem Content="Newest" Tag="newest"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="GalleryEmptyText"
                                           Grid.Row="0"
                                           Text="Loading gallery..."
                                           Foreground="{DynamicResource BrTextTertiary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Panel.ZIndex="2"/>
