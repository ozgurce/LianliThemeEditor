                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock x:Name="AddLayerCurvedBarTitle" Text="Curved Bar" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerCurvedBarDesc" Text="Donut or arc" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
                                                        </Grid>
