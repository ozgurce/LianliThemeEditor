        <Style x:Key="LayerTypeChoiceButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource BrSurface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
        </Style>

        <Style x:Key="LayerIconActionButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionRoot"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionRoot" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="#506FA8E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot" Property="Background" Value="#38246FF2"/>
                                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="#8045A0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="InteractionRoot">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid x:Name="ToolbarIconHost" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Viewbox x:Name="ToolbarIcon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"/>
                                        </Viewbox>
                                    </Grid>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HoverGlow" Background="#16FFFFFF"
                                    BorderBrush="{DynamicResource BrAccentHover}" BorderThickness="1"
                                    CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="">
                                <Setter TargetName="ToolbarIconHost" Property="Margin" Value="0"/>
                                <Setter TargetName="ToolbarIcon" Property="Width" Value="18"/>
                                <Setter TargetName="ToolbarIcon" Property="Height" Value="18"/>
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="ToolbarIconHost" Property="Margin" Value="0"/>
                                <Setter TargetName="ToolbarIcon" Property="Width" Value="18"/>
                                <Setter TargetName="ToolbarIcon" Property="Height" Value="18"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.90"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InteractionRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="1" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InteractionRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.11"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#58749D" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#748398"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource BrAccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource BrSurface2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource ScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="9"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="9"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollBarThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#7FA6BDE8" CornerRadius="3" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#9CB9D2F2"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource BrAccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SidebarScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="0,0,12,0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{DynamicResource SidebarVerticalScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource ExpanderGlassBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassShimmerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Effect="{DynamicResource ShadowCard}"
                                ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="18,14"
                                              Cursor="Hand"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Hdr" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2"
                                                               Fill="{DynamicResource BrAccent}" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <ContentPresenter Grid.Column="1"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True"/>
                                                    <Border Grid.Column="2" Width="28" Height="28" CornerRadius="5"
                                                            Background="#20152D55" VerticalAlignment="Center">
                                                        <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Rectangle Height="2.4" RadiusX="1.2" RadiusY="1.2"
                                                                       Fill="{DynamicResource BrTextTertiary}"
                                                                       VerticalAlignment="Center"/>
                                                            <Rectangle x:Name="ExpanderVerticalLine"
                                                                       Width="2.4" RadiusX="1.2" RadiusY="1.2"
                                                                       Fill="{DynamicResource BrTextTertiary}"
                                                                       HorizontalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hdr" Property="Background" Value="#15234A82"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ExpanderVerticalLine" Property="Opacity" Value="0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Visibility="Collapsed"
                                                  Margin="18,0,18,18"
                                                  Opacity="0"
                                                  RenderTransformOrigin="0.5,0">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform Y="-10"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ExpandSite" Property="Opacity" Value="1"/>
                                <Setter TargetName="ExpandSite" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                             Storyboard.TargetProperty="Opacity"
                                                              From="0" To="1" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                              From="-10" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource GlassPopupBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrBorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                                  Color="#001225" Opacity="0.45"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="MenuItemRoot" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,18,0"/>
                                    <Path x:Name="SubmenuArrow"
                                          Data="M5,3 L9,7 L5,11"
                                          Stroke="{DynamicResource BrTextSecondary}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12" Height="12"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource GlassPopupBrush}"
                                        BorderBrush="{DynamicResource BrBorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemRoot" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedMenuSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource BrBorderSoft}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Margin="0">
        <Grid.Background>
            <ImageBrush ImageSource="Assets/glass-background.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Canvas Grid.RowSpan="7" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.7" CacheMode="BitmapCache">
            <Ellipse Width="760" Height="520" Canvas.Left="-180" Canvas.Top="-230" Fill="{DynamicResource BrDecor1}">
                <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="620" Height="620" Canvas.Right="-180" Canvas.Top="110" Fill="{DynamicResource BrDecor2}">
                <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="520" Height="360" Canvas.Left="620" Canvas.Bottom="-170" Fill="{DynamicResource BrDecor3}">
                <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
            </Ellipse>
            <Path Data="M 0,330 C 360,180 700,470 1080,260 C 1380,95 1640,180 1920,40"
                  Stroke="{DynamicResource BrDecorStroke}" StrokeThickness="70" Opacity="0.28">
                <Path.Effect><BlurEffect Radius="75"/></Path.Effect>
            </Path>
        </Canvas>

        
        
        
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource GlassHeaderBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid VerticalAlignment="Top" Height="48">
                <!-- LEFT: Logo + title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,10,0"
                            BorderThickness="1" BorderBrush="#50246FF2" ClipToBounds="True">
                        <Image Source="editor.ico" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="HeaderTitleText" Text="Lian Li LCD Template Editor"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource BrTextPrimary}"
                               Margin="0,0,8,0"/>
                    <!-- version pill -->
                    <Border CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                            Background="#30246FF2" BorderBrush="#40246FF2" BorderThickness="1">
                        <TextBlock x:Name="HeaderVersionText" Text="" FontSize="10" Foreground="{DynamicResource BrTextTertiary}"/>
                    </Border>
                    <Button x:Name="HeaderSettingsButton"
                            Width="30" Height="28" MinWidth="30"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            ToolTip="Settings"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="HeaderSettingsButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="R" Background="#18152D55" BorderBrush="#30496E9F"
                                        BorderThickness="1" CornerRadius="4">
                                    <Path Data="M10,3 L11,5 L13,5.5 L15,4.5 L16.5,7 L15,8.5 L15,11.5 L16.5,13 L15,15.5 L13,14.5 L11,15 L10,17 L7,17 L6,15 L4,14.5 L2,15.5 L0.5,13 L2,11.5 L2,8.5 L0.5,7 L2,4.5 L4,5.5 L6,5 L7,3 Z M8.5,7.2 A2.8,2.8 0 1 0 8.5,12.8 A2.8,2.8 0 0 0 8.5,7.2"
                                          Fill="Transparent" Stroke="#BFC8D8" StrokeThickness="1.35"
                                          Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="R" Property="Background" Value="#303B82F6"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="R" Property="Background" Value="#203B82F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RestartButton"
                            Tag="M17,7 A7,7 0 1 0 17,15 M17,7 L17,2 M17,7 L12,7"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="8,0,0,0" Background="#20D55263"
                            BorderBrush="#66D55263" BorderThickness="1" Foreground="#D43F53"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="RestartButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#001225"/>
                        </Button.Effect>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RestartButtonText" Text="Restart L-Connect" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <!-- RIGHT: Window controls (hit-test visible) -->
                <Border HorizontalAlignment="Right" Padding="0,0,4,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize -->
                        <Button x:Name="MinimizeWindowButton" Click="MinimizeButton_Click" Width="40" Height="28"
                                MinWidth="40" Margin="0,0,2,0" Cursor="Hand"
                                ToolTip="Minimize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Maximize -->
                        <Button x:Name="MaximizeWindowButton" Click="MaximizeButton_Click" Width="40" Height="28"
                                MinWidth="40" Margin="0,0,2,0" Cursor="Hand"
                                ToolTip="Maximize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Close -->
                        <Button x:Name="CloseWindowButton" Click="CloseButton_Click" Width="40" Height="28"
                                MinWidth="40" Cursor="Hand" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="R" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BFC8D8"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#C0C42B2B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="R" Property="Background" Value="#90C42B2B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Thin glowing separator line between title bar and toolbar -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource BannerSeparatorBrush}" Height="1" VerticalAlignment="Stretch" Visibility="Collapsed"/>

        
        
        
        
        
        
        <Border x:Name="EditorToolbar" Grid.Row="3" Panel.ZIndex="5"
                Height="52" VerticalAlignment="Center"
                Background="{DynamicResource GlassToolbarBrush}"
                BorderBrush="{DynamicResource GlassAccentBorderBrush}" BorderThickness="1"
                Padding="10,0" Margin="8,-1,8,5" CornerRadius="6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Device selector -->
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Template selector -->
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Load / Save / Undo / Redo -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Divider -->
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <!-- Export / Restart / Apply -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DEVICE glass chip -->
                <Border Grid.Column="0" Height="38" Background="#40152D55" BorderBrush="#60496E9F"
                        BorderThickness="1" CornerRadius="4" Padding="6,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="#18496E9F" CornerRadius="4" Padding="5,4" Margin="0,0,6,0">
                            <TextBlock x:Name="DeviceLabel" Text="DEVICE" FontSize="7.5"
                                       FontWeight="Bold"
                                       Foreground="#80A0B8D0" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <!-- Cihaz ikonu -->
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4"
                                BorderThickness="1" BorderBrush="#40246FF2" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF1048A0" Offset="0"/>
                                    <GradientStop Color="#FF082060" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image x:Name="SelectedDeviceImage" Source="Assets/Devices/hydroshift-ii-lcd-s.png"
                                   Stretch="UniformToFill"/>
                        </Border>
                        
                        <Grid Grid.Column="2">
                            <ComboBox x:Name="DeviceCombo" Height="26"
                                      SelectedValuePath="Tag" SelectionChanged="DeviceCombo_SelectionChanged"
                                      IsTextSearchEnabled="False" Opacity="0">
                                <ComboBoxItem Tag="hydroshift-ii-lcd-s" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/hydroshift-ii-lcd-s.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="Hydroshift II LCD-S" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="hydroshift-ii-lcd-c" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/hydroshift-ii-lcd-c.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="Hydroshift II LCD-C" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="universal-screen-8.8-inch" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/universal-screen-8.8.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="8.8&quot; Universal Screen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="vm-9.2-inch" MinHeight="62">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Devices/vm-9.2.png" Width="82" Height="52" Stretch="Uniform" Margin="0,0,11,0"/>
                                        <TextBlock Text="VM 9.2 LCD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            <Border Height="26" Background="{DynamicResource BrSelectionField}"
                                    BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                    CornerRadius="4" IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock x:Name="DeviceSelectionText" Margin="9,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Path Fill="{DynamicResource BrTextTertiary}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TEMPLATE glass chip -->
                <Border Grid.Column="2" Height="38" Background="#40152D55" BorderBrush="#60496E9F"
                        BorderThickness="1" CornerRadius="4" Padding="6,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="#18228040" CornerRadius="4" Padding="5,4" Margin="0,0,6,0">
                            <TextBlock x:Name="TemplateLabel" Text="TEMPLATE ID" FontSize="7.5"
                                       FontWeight="Bold"
                                       Foreground="#8070A890" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <!-- Template ikonu -->
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4"
                                BorderThickness="1" BorderBrush="#40228040" Margin="0,0,6,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF104830" Offset="0"/>
                                    <GradientStop Color="#FF082818" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image x:Name="SelectedTemplateImage" Stretch="UniformToFill"/>
                        </Border>
                        
                        <Grid Grid.Column="2">
                            <ComboBox x:Name="TemplateCombo" Height="26"
                                      SelectionChanged="TemplateCombo_SelectionChanged"
                                      IsTextSearchEnabled="False"
                                      Style="{StaticResource TemplateComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource TemplateComboBoxItemStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="74" SnapsToDevicePixels="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ThumbnailColumnWidth}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="{Binding ThumbnailBoxWidth}"
                                                    Height="{Binding ThumbnailBoxHeight}"
                                                    CornerRadius="4" ClipToBounds="True"
                                                    Background="#FF08172F" Margin="0,2,8,2"
                                                    HorizontalAlignment="Left">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                       SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Id}"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       LineHeight="13"
                                                       MaxHeight="28"
                                                       Foreground="{DynamicResource BrTextSecondary}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border Height="26" Background="{DynamicResource BrSelectionField}"
                                    BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                    CornerRadius="4" IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock x:Name="TemplateSelectionText" Margin="9,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Path Fill="{DynamicResource BrTextTertiary}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Vertical divider 1 -->
                <Rectangle Grid.Column="4" Width="1" Height="32"
                            Fill="#40496E9F" VerticalAlignment="Center"/>

                <!-- Load / Save / Undo / Redo icon buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ActiveThemeButton" Content="Active Theme"
                            Tag="M3,4 H17 V14 H3 Z M7,17 H13 M10,14 V17 M6,8 L9,11 L14,6"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="ActiveThemeButton_Click"/>
                    <Button x:Name="NewThemeButton" Content="New Theme"
                            Tag="M10,3 V17 M3,10 H17"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="NewThemeButton_Click"/>
                    <Button x:Name="LoadButton" Content="Load"
                            Tag="M2,5 L7,5 L9,7 L18,7 L18,17 L2,17 Z M2,5 L2,3 L8,3 L10,5"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="LoadButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save"
                            Tag="M4,3 H16 L19,6 V17 H4 Z M7,3 V8 H14 V3 M7,14 H16 M7,11 H16"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="ApplyAllButton_Click"/>
                    <Button x:Name="DeleteTemplateButton" Content="" Width="38"
                            Tag="M5,6 H15 M8,6 V4 H12 V6 M7,8 V16 M10,8 V16 M13,8 V16 M6,6 L7,18 H13 L14,6"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="DeleteTemplateButton_Click" ToolTip="Delete selected non-official theme"/>
                    <Button x:Name="UndoButton" Content="" Width="38"
                            Tag="M8,5 L4,9 L8,13 M4,9 H12 A5,5 0 1 1 8,17"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="UndoButton_Click" ToolTip="Revert last template change (Ctrl+Z)"/>
                    <Button x:Name="UndoHistoryButton" Content="" Width="38"
                            Tag="M4,3 H16 V17 H4 Z M7,6 H13 M7,9 H13 M7,12 H11 M15,3 L17,5 V19 H6"
                            Style="{DynamicResource ToolbarIconButton}" Margin="-4,0,6,0"
                            Click="UndoHistoryButton_Click" ToolTip="Open edit history"/>
                    <Button x:Name="RedoButton" Content="" Width="38"
                            Tag="M12,5 L16,9 L12,13 M16,9 H8 A5,5 0 1 0 12,17"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="RedoButton_Click" ToolTip="Restore template change (Ctrl+Y)"/>
                </StackPanel>

                <!-- Vertical divider 2 -->
                <Rectangle Grid.Column="8" Width="1" Height="32"
                            Fill="#40496E9F" VerticalAlignment="Center"/>

                <!-- Hidden template ID box -->
                <TextBox x:Name="TemplateIdBox" ToolTip="Template ID" Visibility="Collapsed"
                         Grid.Column="10"/>
                <CheckBox x:Name="UseActiveCheck" Grid.Column="10" Content="Use active template"
                          IsChecked="True" Checked="UseActiveCheck_Changed"
                          Visibility="Collapsed"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <CheckBox x:Name="OfflineModeCheck" Content="Offline"
                              ToolTip="Work on a local copy without sending changes to L-Connect"
                              Checked="OfflineModeCheck_Changed" Unchecked="OfflineModeCheck_Changed"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyOrientationButton" Content="Change Orientation"
                            Tag="M4,3 H10 V15 H4 Z M6,5 V13 M10,7 C13,7 15,9 16,12 M16,12 L14,10 M16,12 L18,10 M10,15 H18 V19 H10 Z M12,17 H16"
                            Style="{DynamicResource ToolbarIconButton}"
                            Visibility="Collapsed"
                            Click="ApplyOrientationButton_Click"
                            ToolTip="Save as a new theme with the selected orientation"/>
                </StackPanel>

                <!-- RIGHT ACTION BUTTONS -->
                <StackPanel Grid.Column="11" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <Button x:Name="BackupButton" Content="" Width="38" ToolTip="Create a template backup"
                            Tag="M3,7 H17 V18 H3 Z M5,4 H15 L17,7 H3 Z M10,9 V15 M7,12 L10,15 L13,12"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,6,0"
                            Click="BackupButton_Click"/>
                    <Button x:Name="RestoreBackupButton" Content="" Width="38" ToolTip="Restore backup"
                            Tag="M3,7 H17 V18 H3 Z M5,4 H15 L17,7 H3 Z M10,16 V10 M7,13 L10,10 L13,13"
                            Style="{DynamicResource ToolbarIconButton}" Margin="0,0,8,0"
                            Click="RestoreBackupButton_Click"/>
                    <Button x:Name="ExportLConnectButton"
                            Tag="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,19 L17,19 L17,16"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0" Background="#2020BFA8"
                            BorderBrush="#6620BFA8" BorderThickness="1" Foreground="#009E8F"
                            Click="ExportLConnectButton_Click">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#001225"/>
                        </Button.Effect>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExportLConnectButtonText" Text="Export Theme" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    
                    <Button x:Name="EditorImportThemeButton"
                            Content="Import Theme"
                            Tag="M4,18 L4,15 C4,13 6,12 8,12 H12 C14,12 16,13 16,15 V18 M10,3 L10,13 M6,7 L10,3 L14,7"
                            Style="{DynamicResource ToolbarIconButton}"
                            Margin="0,0,8,0"
                            Click="ImportThemeButton_Click"/>


                    
                    <Button x:Name="ApplyAllButton"
                            Tag="M3,10 L8,15 L18,4"
                            Style="{DynamicResource ToolbarIconButton}"
                            BorderThickness="0"
                            Click="ApplyAllButton_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF1A6CD8" Offset="0"/>
                                <GradientStop Color="#FF246FF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ApplyAllButtonText" Text="Apply All"
                                           VerticalAlignment="Center" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <TextBlock x:Name="SupporterPathText" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

