                                </Border>
                                <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel><TextBlock x:Name="SettingsLanguageThemeTitleText" Text="Language &amp; theme" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="SettingsLanguageThemeDescText" Text="These choices also update the footer controls." Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource BrTextTertiary}"/><ComboBox x:Name="SettingsLanguageCombo" SelectionChanged="SettingsLanguageCombo_SelectionChanged"><ComboBoxItem Content="" Tag="en"/><ComboBoxItem Content="" Tag="tr"/><ComboBoxItem Content="" Tag="ru"/><ComboBoxItem Content="" Tag="zh"/></ComboBox><ComboBox x:Name="SettingsThemeCombo" Margin="0,10,0,0" SelectionChanged="SettingsThemeCombo_SelectionChanged"><ComboBoxItem Content="Dark" Tag="dark"/><ComboBoxItem Content="Light" Tag="light"/></ComboBox></StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,12,12">
                                    <StackPanel><TextBlock x:Name="SettingsGalleryTitleText" Text="Theme Gallery" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="SettingsGalleryDescText" Text="Automatically apply downloaded themes after installation." Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource BrTextTertiary}"/><CheckBox x:Name="AutoApplyGalleryThemesCheck" Content="Apply automatically" IsChecked="True" Checked="AutoApplyGalleryThemes_Changed" Unchecked="AutoApplyGalleryThemes_Changed"/><CheckBox x:Name="AnimateVideoPreviewsCheck" Content="Play animated previews" IsChecked="True" Margin="0,7,0,0" Checked="AnimateVideoPreviews_Changed" Unchecked="AnimateVideoPreviews_Changed"/></StackPanel>
                                </Border>
                                <Border Style="{DynamicResource Card}" Padding="16" Margin="0,0,12,12">
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="SettingsUnusedSensorsTitleText" Text="Map unused L-Connect sensors" FontSize="14" FontWeight="SemiBold"/><Button Content="?" Width="25" Height="25" Margin="8,0,0,0" Padding="0" Click="UnusedSensorsHelp_Click"/></StackPanel><TextBlock x:Name="SettingsUnusedSensorsDescText" Text="Map unused L-Connect sensors to other values" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource BrTextTertiary}"/><CheckBox x:Name="UnusedSensorsComingSoonCheck" Content="Coming soon" IsEnabled="False"/></StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="Diagnostics" Visibility="Collapsed">
