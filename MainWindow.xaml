                                                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock x:Name="AddLayerRingGraphTitle" Text="Ring Graph" FontWeight="SemiBold"/><TextBlock x:Name="AddLayerRingGraphDesc" Text="Circular sensor gauge" FontSize="9.5" Foreground="{DynamicResource BrTextTertiary}"/></StackPanel>
