                                    <Button x:Name="AddDataButton" Width="190" Margin="0,24,0,10" Content="Add Data" Style="{DynamicResource BtnPrimary}" Click="AddDataButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="AddImageButton" Width="240" Margin="0,24,0,10" Content="Choose &amp; Add Image" Style="{DynamicResource BtnPrimary}" Click="AddImageButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="AddGraphButton" Width="190" Margin="0,24,0,10" Content="Add Graph" Style="{DynamicResource BtnPrimary}" Click="AddGraphButton_Click" Visibility="Collapsed"/>
