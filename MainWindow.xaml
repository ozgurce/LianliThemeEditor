                                        <CheckBox x:Name="AddBoldCheck" Content="Bold"/>
                                    </StackPanel>
                                    <Button x:Name="AddTextButton" Width="190" Margin="0,24,0,10" Content="Add Text" Style="{DynamicResource BtnPrimary}" Click="AddTextButton_Click"/>
                                    <Button x:Name="AddDataButton" Width="190" Margin="0,24,0,10" Content="Add Data" Style="{DynamicResource BtnPrimary}" Click="AddDataButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="AddImageButton" Width="240" Margin="0,24,0,10" Content="Choose &amp; Add Image" Style="{DynamicResource BtnPrimary}" Click="AddImageButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="AddGraphButton" Width="190" Margin="0,24,0,10" Content="Add Graph" Style="{DynamicResource BtnPrimary}" Click="AddGraphButton_Click" Visibility="Collapsed"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AddShadowExpander" Grid.Row="4" IsExpanded="False" Visibility="Collapsed">
                        <Expander.Header>
                            <TextBlock x:Name="ShadowHeaderText" Text="Drop Shadow" FontSize="15" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                                                                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock x:Name="ShadowTitleText" Grid.Row="0" Grid.Column="0" Text="Shadow options" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox x:Name="PairCheck" Content="Pair" Margin="0,0,10,0" IsChecked="True"/>
                                <CheckBox x:Name="SyncShadowColorCheck" Content="Sync" IsChecked="True"/>
                            </StackPanel>
                            
                            <Label x:Name="ShadowXLabel" Grid.Row="2" Grid.Column="0" Content="OFFSET X"/>
                            <Grid Grid.Row="2" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                <Button Content="-" Style="{DynamicResource CompactStepLeft}" Click="ShadowXMinus_Click"/>
                                <TextBox x:Name="ShadowXBox" Grid.Column="1" TextAlignment="Center" Text="4" Style="{DynamicResource CompactNumberBox}"/>
                                <Button Grid.Column="2" Content="+" Style="{DynamicResource CompactStepRight}" Click="ShadowXPlus_Click"/>
                            </Grid>
                            
                            <Label x:Name="ShadowYLabel" Grid.Row="3" Grid.Column="0" Content="OFFSET Y"/>
                            <Grid Grid.Row="3" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                <Button Content="-" Style="{DynamicResource CompactStepLeft}" Click="ShadowYMinus_Click"/>
                                <TextBox x:Name="ShadowYBox" Grid.Column="1" TextAlignment="Center" Text="4" Style="{DynamicResource CompactNumberBox}"/>
                                <Button Grid.Column="2" Content="+" Style="{DynamicResource CompactStepRight}" Click="ShadowYPlus_Click"/>
                            </Grid>
                            
                            <Label x:Name="ShadowColorLabel" Grid.Row="4" Grid.Column="0" Content="COLOR"/>
                            <Grid Grid.Row="4" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ShadowColorBox" Grid.Column="0" Text="#66000000"/>
                                <Button x:Name="ShadowColorPickButton" Style="{DynamicResource ColorPickerButtonFixed}" Grid.Column="1" Margin="4,0,2,0" Click="ShadowColorPickButton_Click" ToolTip="Pick Shadow Color"/>
                            </Grid>
                            
                            <TextBlock x:Name="ShadowAutoAddHint" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                       Text="Added with layer." Foreground="{DynamicResource BrTextTertiary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Expander>

                </Grid>
                </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" ShowsPreview="True"/>

            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button x:Name="BackgroundButton" Content="Upload Background (GIF / JPG / MP4)" 
                                Style="{DynamicResource BtnPrimary}" Background="{DynamicResource BrPurple}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Padding="16,8" Click="BackgroundButton_Click"/>
                        <TextBlock x:Name="DragHintText" Text="Drag to reposition"
                                   Foreground="{DynamicResource BrTextTertiary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="−" Style="{DynamicResource BtnNudge}" Click="CanvasZoomMinus_Click"/>
                            <Border Background="{DynamicResource BrField}" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                                    Padding="14,8" Margin="6,0" CornerRadius="6">
                                <TextBlock x:Name="CanvasZoomText" Text="100%" FontWeight="SemiBold"/>
                            </Border>
                            <Button Content="+" Style="{DynamicResource BtnNudge}" Click="CanvasZoomPlus_Click"/>
                            <Slider x:Name="CanvasZoomSlider"
                                    Style="{DynamicResource NumericSlider}"
                                    Width="150"
                                    Minimum="1"
                                    Maximum="3"
                                    Value="1.8"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CanvasZoomSlider_ValueChanged"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="PreviewFrame" Grid.Row="1" Width="240" Height="240" Padding="0" Background="Black" BorderBrush="{DynamicResource BrBorder}" BorderThickness="1" CornerRadius="0" ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="PreviewSurface" Width="240" Height="240">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,240,240"/>
                            </Grid.Clip>
                            <MediaElement x:Name="BackgroundMedia" Width="240" Height="240" Stretch="Fill" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaEnded="BackgroundMedia_MediaEnded"/>
                            <Image x:Name="BackgroundImage" Width="240" Height="240" Stretch="Fill" Visibility="Collapsed"/>
                            <Rectangle Fill="#08000000"/>
                            <Canvas x:Name="PreviewCanvas" Width="240" Height="240" Background="Transparent"
                                    Focusable="True" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"/>
                            <Grid IsHitTestVisible="False">
                                <Rectangle Height="5" VerticalAlignment="Top" Fill="Black"/>
                                <Rectangle Height="5" VerticalAlignment="Bottom" Fill="Black"/>
                                <Rectangle Width="5" HorizontalAlignment="Left" Fill="Black"/>
                                <Rectangle Width="5" HorizontalAlignment="Right" Fill="Black"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="6" Background="#14060E1C" BorderBrush="{StaticResource GlassShimmerBrush}" BorderThickness="0,1,0,0" Padding="18,0" Margin="0" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="94"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource BrAccent}" Margin="2,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource BrTextTertiary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TemplateTitleText" Text="Template: -" Foreground="{DynamicResource BrTextSecondary}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TemplatePathText" Text="" Foreground="{DynamicResource BrTextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" MaxWidth="300"/>
                    <TextBlock x:Name="BackgroundText" Text="BG: -" Foreground="{DynamicResource BrTextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                </StackPanel>
                <TextBlock x:Name="LanguageLabel" Grid.Column="2" Text="Language" Foreground="{DynamicResource BrTextTertiary}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="4" Height="28" VerticalAlignment="Center" SelectedValuePath="Tag" SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Türkçe" Tag="tr"/>
                        <ComboBoxItem Content="Русский" Tag="ru"/>
                        <ComboBoxItem Content="中文" Tag="zh"/>
                    </ComboBox>
                    <TextBlock x:Name="ThemeLabel" Grid.Column="6" Text="Theme" Visibility="Collapsed"/>
                    <ComboBox x:Name="UiThemeCombo" Grid.Column="8" Height="28" Visibility="Collapsed" SelectedValuePath="Tag" SelectionChanged="UiThemeCombo_SelectionChanged">
                        <ComboBoxItem x:Name="DarkThemeItem" Content="Dark" Tag="dark"/>
                        <ComboBoxItem x:Name="LightThemeItem" Content="Light" Tag="light"/>
                    </ComboBox>
                    <TextBlock Grid.Column="10" Text="Ozgur Yalcin - @ozgur.ny" Foreground="{DynamicResource BrTextTertiary}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

























