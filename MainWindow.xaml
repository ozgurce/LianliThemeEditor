                                                    <Setter TargetName="LayerLockIcon" Property="Height" Value="16"/>
                                                    <Setter TargetName="LayerLockButton" Property="Background" Value="{DynamicResource BrLockBackground}"/>
                                                    <Setter TargetName="LayerLockButton" Property="BorderBrush" Value="{DynamicResource BrLockBorder}"/>
                                                    <Setter TargetName="LayerLockButton" Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter TargetName="DirtyBadge" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="LayerCard" Property="Background" Value="{DynamicResource BrSelectedLayer}"/>
                                                    <Setter TargetName="LayerCard" Property="BorderBrush" Value="#6D92B6E6"/>
                                                    <Setter TargetName="LayerCard" Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
