<Window x:Class="ThemeEditorCSharp.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker"
        Width="460"
        Height="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ColBg">#181B22</Color>
        <Color x:Key="ColBorder">#303642</Color>
        <Color x:Key="ColAccent">#12796F</Color>
        <Color x:Key="ColAccentHover">#168B80</Color>
        <Color x:Key="ColTextPrimary">#F5F7FA</Color>
        <Color x:Key="ColTextSecondary">#C9D1D9</Color>
        <Color x:Key="ColField">#0E1015</Color>

        <SolidColorBrush x:Key="BrBg" Color="{StaticResource ColBg}"/>
        <SolidColorBrush x:Key="BrBorder" Color="{StaticResource ColBorder}"/>
        <SolidColorBrush x:Key="BrAccent" Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentHover" Color="{StaticResource ColAccentHover}"/>
        <SolidColorBrush x:Key="BrTextPrimary" Color="{StaticResource ColTextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSecondary" Color="{StaticResource ColTextSecondary}"/>
        <SolidColorBrush x:Key="BrField" Color="{StaticResource ColField}"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Background" Value="{StaticResource BrField}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="{StaticResource BrAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#252A34"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Grid/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrBg}" BorderBrush="{StaticResource BrBorder}" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Select Color" FontSize="14" FontWeight="SemiBold"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource BrTextSecondary}" BorderThickness="0" Cursor="Hand" Click="Cancel_Click" FontSize="14"/>
            </Grid>

            <!-- Top Color Preview & Hex input -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Checkered background for alpha transparency preview -->
                <Border Width="80" Height="50" CornerRadius="6" Background="White" ClipToBounds="True">
                    <Grid>
                        <!-- Grid pattern for transparent background -->
                        <UniformGrid Columns="8" Rows="5">
                            <UniformGrid.Resources>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="#DDD"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Converter={x:Null}}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Resources>
                            <!-- Row 1 -->
                            <Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/>
                            <Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/>
                            <!-- Row 2 -->
                            <Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/>
                            <Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/>
                            <!-- Row 3 -->
                            <Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/>
                            <Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/>
                            <!-- Row 4 -->
                            <Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/>
                            <Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/>
                            <!-- Row 5 -->
                            <Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/>
                            <Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/><Rectangle Fill="#EEE"/><Rectangle Fill="#AAA"/>
                        </UniformGrid>
                        <!-- Actual Color Overlay -->
                        <Border x:Name="ColorPreviewBorder" CornerRadius="6" BorderBrush="{StaticResource BrBorder}" BorderThickness="1"/>
                    </Grid>
                </Border>

                <!-- HEX input -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="HEX" Margin="0,0,8,0" Foreground="{StaticResource BrTextSecondary}"/>
                    <TextBox x:Name="HexInput" Width="100" Height="32" VerticalContentAlignment="Center" TextAlignment="Left" Padding="8,0" GotFocus="HexInput_GotFocus" LostFocus="HexInput_LostFocus"/>
                </StackPanel>
            </Grid>

            <!-- Sliders and Preset Palettes -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <!-- Red Slider -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Red" Foreground="#FF5555"/>
                <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="1" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="RedInput" Grid.Row="0" Grid.Column="2" TextChanged="Input_TextChanged"/>

                <!-- Green Slider -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Green" Foreground="#55FF55" Margin="0,8,0,0"/>
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Margin="5,8,5,0" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="GreenInput" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" TextChanged="Input_TextChanged"/>

                <!-- Blue Slider -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Blue" Foreground="#5555FF" Margin="0,8,0,0"/>
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Margin="5,8,5,0" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="BlueInput" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" TextChanged="Input_TextChanged"/>

                <!-- Alpha Slider -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Opacity" Foreground="{StaticResource BrTextSecondary}" Margin="0,8,0,0"/>
                <Slider x:Name="AlphaSlider" Grid.Row="3" Grid.Column="1" Margin="5,8,5,0" ValueChanged="Slider_ValueChanged"/>
                <TextBox x:Name="AlphaInput" Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" TextChanged="Input_TextChanged"/>

                <!-- Preset Palettes -->
                <Grid Grid.Row="5" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Presets &amp; Opacity Levels" Foreground="{StaticResource BrTextSecondary}" Margin="0,0,0,6" FontSize="11" FontWeight="SemiBold"/>
                    <WrapPanel x:Name="PresetWrap" Grid.Row="1" Orientation="Horizontal"/>
                </Grid>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Style="{DynamicResource BtnGhost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Select" Style="{DynamicResource BtnPrimary}" Click="Select_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

